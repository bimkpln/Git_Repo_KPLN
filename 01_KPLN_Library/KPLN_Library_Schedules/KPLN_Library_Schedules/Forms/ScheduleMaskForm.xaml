<Window x:Class="KPLN_Library_Schedules.Forms.ScheduleMaskForm"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="KPLN: Конструктор маски" Width="740" Height="490" MinWidth="650" MinHeight="460"
 WindowStartupLocation="CenterOwner" Background="#2B2F38" Foreground="#EDEDED" FontFamily="Segoe UI" FontSize="14">
 <Window.Resources><ResourceDictionary Source="ScheduleManagerStyles.xaml"/></Window.Resources>
 <Grid Margin="16"><Grid.RowDefinitions>
 <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
 </Grid.RowDefinitions>
 <TextBlock Style="{StaticResource Hint}" Text="Маски — подстановки плагина, а не имена параметров Revit. Введите обычный текст и вставьте нужные подстановки в позицию курсора."/>
 <TextBox x:Name="PatternBox" Grid.Row="1" TextChanged="UpdateExample" ToolTip="Например: 2.{Этаж}. Обычный текст сохраняется, подстановки в фигурных скобках заменяются значениями."/>
 <DockPanel Grid.Row="2"><Button DockPanel.Dock="Right" Content="Вставить" Click="InsertToken" ToolTip="Вставить выбранную подстановку в позицию курсора, заменив выделенный текст."/>
 <ComboBox x:Name="TokensBox" SelectionChanged="SelectToken" ToolTip="Выберите подстановку. Наведите на пункт, чтобы прочитать пояснение.">
 <ComboBox.ItemContainerStyle><Style TargetType="ComboBoxItem"><Setter Property="ToolTip" Value="{Binding Description}"/></Style></ComboBox.ItemContainerStyle>
 <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Token}"/></DataTemplate></ComboBox.ItemTemplate>
 </ComboBox></DockPanel>
 <TextBlock x:Name="DescriptionText" Grid.Row="3" Style="{StaticResource Hint}"/>
 <TextBlock x:Name="ContextText" Grid.Row="4" Style="{StaticResource Hint}" Text="Для подстановок этажа, уровня, отметки и типовых этажей выберите уровни в основном окне копирования листов."/>
 <StackPanel Grid.Row="5"><TextBlock x:Name="SampleText" Style="{StaticResource Hint}" Text="Учебный пример: этаж 3, уровень «03 этаж», отметка +9.000, типовые 3–5, индекс 1. Это не результат проверки модели."/>
 <TextBlock x:Name="ExampleText" Style="{StaticResource Hint}" FontWeight="SemiBold"/></StackPanel>
 <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Применить маску" Click="Apply"/><Button Content="Отмена" IsCancel="True"/></StackPanel>
 </Grid>
</Window>
