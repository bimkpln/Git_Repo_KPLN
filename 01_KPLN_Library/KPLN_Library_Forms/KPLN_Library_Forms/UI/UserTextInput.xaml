<Window x:Class="KPLN_Library_Forms.UI.UserTextInput"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:local="clr-namespace:KPLN_Library_Forms.UI"
        mc:Ignorable="d" 
        FontFamily="Monaco, Consolas, 'Andale Mono', 'DejaVu Sans Mono', monospace"
        Title="KPLN: Комментарий" 
        Width="400" 
        Height="200"  
        Background="#2B2F38"
        WindowStartupLocation="CenterOwner" 
        ResizeMode="NoResize" 
        WindowStyle="ToolWindow" 
        Topmost="True" 
        Loaded="OnLoaded">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.Resources>
            <local:IntToBoolConverter x:Key="IntToBoolConverter"/>
        </Grid.Resources>

        <TextBlock 
            x:Name="tbHeader" 
            Grid.Row="0" 
            Style="{StaticResource KPLN_TextBlock}"
            Text="Задаётся через конструктор!" 
            FontWeight="Bold"/>

        <TextBox 
            x:Name="tBox" 
            Grid.Row="1"
            xml:lang="ru-RU"
            Style="{StaticResource KPLN_TextBox}"
            TextWrapping="Wrap"/>

        <Button 
            x:Name="btnApply" 
            Grid.Row="2" 
            Style="{StaticResource KPLN_TextInputButton}"
            IsEnabled="{Binding ElementName=tBox, Path=Text.Length, Converter={StaticResource IntToBoolConverter}}" 
            HorizontalAlignment="Left" 
            ToolTip="Действие необходимо подтверждать развернутым комментарием (более 5 символов)" 
            Content="Применить"
            Click="OnBtnApply" 
            IsDefault="True"/>
    </Grid>
</Window>
