<Window x:Class="KPLN_Library_Forms.UI.ElementMultiPick"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:local="clr-namespace:KPLN_Library_Forms.UI"
        mc:Ignorable="d" 
        MinWidth="400" 
        MinHeight="400"
        MaxWidth="600"
        MaxHeight="800"
        FontFamily="Monaco, Consolas, 'Andale Mono', 'DejaVu Sans Mono', monospace"
        Background="#2B2F38"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="ToolWindow" 
        WindowStartupLocation="CenterScreen" 
        SizeToContent="WidthAndHeight" 
        Loaded="OnLoaded">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <DockPanel 
            Background="#333840"
            LastChildFill="True">
            <TextBlock
                Text="Поиск:"
                Foreground="#EDEDED"
                VerticalAlignment="Center"
                FontWeight="Bold" 
                Margin="5"/>
            <TextBox 
                x:Name="SearchText"
                Style="{StaticResource KPLN_TextBox}"
                Grid.Row="0" 
                TextChanged="SearchText_Changed"
                TextAlignment="Left" 
                VerticalAlignment="Center" 
                DockPanel.Dock="Right" 
                FontStretch="ExtraExpanded"/>
        </DockPanel>

        <GridSplitter 
            Grid.Row="0" 
            Height="5" 
            Grid.ColumnSpan ="1" 
            VerticalAlignment="Bottom" 
            HorizontalAlignment="Stretch"/>

        <ScrollViewer 
            Grid.Row="1" 
            Margin="0, 0, 0, 5"
            HorizontalScrollBarVisibility="Auto" 
            VerticalScrollBarVisibility="Auto">
            <ItemsControl 
                x:Name="Elements">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox 
                            Style="{StaticResource KPLN_CheckBox}"
                            ToolTip="{Binding Tooltip}"
                            IsChecked ="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}">
                            <CheckBox.Content>
                                <TextBlock 
                                    Text="{Binding Name}"
                                    HorizontalAlignment="Stretch"/>
                            </CheckBox.Content>
                        </CheckBox>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <GridSplitter 
            Grid.Row="1" 
            Height="5" 
            Grid.ColumnSpan ="1" 
            VerticalAlignment="Bottom" 
            HorizontalAlignment="Stretch"/>

        <Grid
            Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            
            <Button 
                x:Name="CheckAllBtn" 
                Style="{StaticResource KPLN_RunButton}"
                Content="Выбрать всё" 
                ToolTip="Нажми, если хочешь выбрать все элементы из представленного списка" 
                Click="CheckAllBtn_Click"/>
            <Button 
                x:Name="ToggleBtn" 
                Grid.Column="2"
                Style="{StaticResource KPLN_RunButton}"
                Content="Инверсия" 
                ToolTip="Нажми, если хочешь выполнить инверсию выбора - где галок нет - появятся, где галки есть - исчезнут" 
                Click="ToggleBtn_Click"/>

            <Button 
                x:Name="RunBtn"
                Grid.Row="1"
                Grid.ColumnSpan="2" 
                Style="{StaticResource KPLN_RunButton}"
                Content="Запуск" 
                Click="RunBtn_Click"/>
        </Grid>
    </Grid>
</Window>
