<Window x:Class="KPLN_Library_Forms.UI.UserDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:local="clr-namespace:KPLN_Library_Forms.UI"
        mc:Ignorable="d" 
        FontFamily="Monaco, Consolas, 'Andale Mono', 'DejaVu Sans Mono', monospace"
        Title="KPLN: Предупреждение" 
        MaxWidth="400" 
        SizeToContent="WidthAndHeight" 
        Background="#2B2F38"
        WindowStartupLocation="CenterScreen" 
        ResizeMode="NoResize" 
        WindowStyle="ToolWindow" 
        Topmost="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="LibStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <Grid Grid.Row="0" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <TextBlock 
                x:Name="tbHeader" 
                TextWrapping="Wrap" 
                Margin="5,0,0,0" 
                Grid.Row="0" 
                Text="Заголовок" 
                FontWeight="Bold" 
                FontSize="16" 
                Foreground="#EDEDED"/>

            <TextBox  
                x:Name="tbBody" 
                Grid.Row="1" 
                Style="{StaticResource KPLN_UserDialogTextBox}"
                Text="С другой стороны укрепление и развитие структуры требуют от нас анализа модели развития."/>
        </Grid>
        
        <Rectangle 
            Grid.Row="1" 
            Grid.Column="0"
            Grid.ColumnSpan="2" 
            Fill="White" 
            RadiusX="3" 
            RadiusY="3" 
            Opacity="0.1"/>
        
        <StackPanel 
            Grid.Row="1" 
            Grid.Column="0" 
            Grid.ColumnSpan="2" 
            Margin="0,5,0,5" 
            Orientation="Horizontal">
            <Button 
                x:Name="btnOk" 
                Style="{StaticResource KPLN_UserDialogButton}"
                Content="Ок" 
                IsDefault="True" 
                Click="OnOk"/>
            <Button 
                x:Name="btnCancel" 
                Style="{StaticResource KPLN_UserDialogButton}"
                Content="Отмена" 
                Click="OnCancel"/>
        </StackPanel>
        
        <TextBlock 
            x:Name="tbFooter" 
            Grid.Row="2" 
            Grid.Column="0"
            Grid.ColumnSpan="2" 
                Style="{StaticResource KPLN_TextBlock}"
            Text="Примечание" 
            Opacity="0.5"/>
    </Grid>
</Window>
