<Window x:Class="KPLN_BIMTools_Ribbon.Forms.AutostartConfigItem"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KPLN: настройки автозапуска" Width="610" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#FF292D36" FontFamily="Consolas, Segoe UI" FontSize="13">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/KPLN_Library_Forms;component/UI/LibStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <StackPanel Margin="14">
        <TextBlock Text="{Binding ConfigurationName}" Style="{StaticResource TXT}"
                   FontWeight="Bold" TextWrapping="Wrap" MaxWidth="580" HorizontalAlignment="Stretch" Margin="0,0,0,12"/>
        <Border
                BorderBrush="White" BorderThickness="1" CornerRadius="4" Margin="0,0,0,5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="270"/>
                </Grid.ColumnDefinitions>
                <TextBlock
                    Text="Кому отправить уведомление?"
                    Padding="7" FontSize="12" FontWeight="Bold"
                    Foreground="White" TextWrapping="Wrap" VerticalAlignment="Center"/>
                <ComboBox
                    Grid.Column="1" Margin="5" FontSize="12"
                    VerticalAlignment="Center"
                    ItemsSource="{Binding NotificationUsers}"
                    SelectedItem="{Binding SelectedNotificationUser, Mode=TwoWay}"
                    IsTextSearchEnabled="True" TextSearch.TextPath="Surname"
                    ToolTipService.ShowOnDisabled="True">
                    <ComboBox.ToolTip>
                        <TextBlock Text="{Binding NotificationUserHelp}" MaxWidth="350"
                                   TextWrapping="Wrap" Foreground="Black"/>
                    </ComboBox.ToolTip>
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Foreground="Black" ToolTip="{Binding SystemName}">
                                <Run Text="{Binding Surname}"/><Run Text=" "/><Run Text="{Binding Name}"/>
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Grid.Row="1" Text="Дата и время старта:" Padding="7" FontSize="12"
                           FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                <Grid Grid.Row="1" Grid.Column="1" Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="70"/>
                    </Grid.ColumnDefinitions>
                    <DatePicker x:Name="AutostartDatePicker" FontSize="12"
                                SelectedDate="{Binding AutostartStartDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                ToolTip="Дата первого запуска. Время указано в часовом поясе этого компьютера."/>
                    <ComboBox Grid.Column="1" Margin="4,0,0,0" FontSize="12" IsEditable="False"
                              ItemsSource="{Binding AutostartTimes}"
                              SelectedItem="{Binding AutostartStartTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>
                <TextBlock Grid.Row="2" Text="Интервал выгрузок, ч:" Padding="7" FontSize="12"
                           FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                <Grid Grid.Row="2" Grid.Column="1" Margin="5"
                      ToolTip="Минимум 12 часов, шаг 12. Например: 12 — утро и вечер, 24 — раз в сутки. Проверка при запуске Revit; пропущенные интервалы выполняются один раз.">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="35"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="35"/>
                    </Grid.ColumnDefinitions>
                    <Button Content="−12" Click="OnIntervalDecrease" Padding="2" FontSize="12"/>
                    <TextBox Grid.Column="1" Margin="3,0" FontSize="12" HorizontalContentAlignment="Center"
                             Text="{Binding AutostartIntervalHours, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Grid.Column="2" Content="+12" Click="OnIntervalIncrease" Padding="2" FontSize="12"/>
                </Grid>
                <TextBlock Grid.Row="3" Text="Последнее завершение выгрузки:" Padding="7" FontSize="12"
                           FontWeight="Bold" Foreground="White" TextWrapping="Wrap" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding LastExportDisplay}" Margin="5" FontSize="12"
                           Foreground="White" TextWrapping="Wrap" VerticalAlignment="Center"
                           ToolTip="Записывается после обработки конфигурации, включая ошибки. Интервал расписания отсчитывается по запускам, а не по завершениям."/>
            </Grid>
        </Border>
        <CheckBox x:Name="SkipWeekendsCheckBox" Content="Пропускать субботу и воскресенье"
                  Style="{StaticResource CHB}" Foreground="White" FontSize="13" Margin="0,6"
                  IsChecked="{Binding SkipWeekends, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  ToolTip="День недели определяется по местному времени компьютера. Пропущенные интервалы не запускаются отдельной очередью; даты попытки в выходные не меняются."/>
        <TextBlock Text="{Binding NotificationUserHelp}" Style="{StaticResource TXT}" FontSize="13"
                   TextWrapping="Wrap" MaxWidth="580" HorizontalAlignment="Stretch" Margin="0,6"/>
        <TextBlock Text="Изменения применятся только после нажатия 🖬 в диспетчере. Отмена вернёт прежнее состояние галки и настроек."
                   Style="{StaticResource TXT}" FontSize="13" TextWrapping="Wrap" MaxWidth="580" HorizontalAlignment="Stretch" Margin="0,6"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="btnOk" Content="✔ Подтвердить" Style="{StaticResource BTN}"
                    Width="160" Height="32" Margin="0,0,8,0" IsDefault="True" Click="OnBtnOkClick"/>
            <Button Content="Отмена" Style="{StaticResource BTN}" Width="110" Height="32" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
