<Window x:Class="KPLN_BIMTools_Ribbon.Forms.DBProjectCreateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KPLN_DB: Новый проект"
        Width="680"
        Height="650"
        MinWidth="620"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Consolas, 'Segoe UI', monospace"
        FontSize="14"
        Background="#2B2F38">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/KPLN_Library_Forms;component/UI/LibStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="FormLabel" TargetType="TextBlock" BasedOn="{StaticResource KPLN_TextBlock}">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="4,8" />
                <Setter Property="MaxWidth" Value="220" />
            </Style>

            <Style x:Key="ValidatedTextBox" TargetType="TextBox" BasedOn="{StaticResource KPLN_TextBox}">
                <Style.Triggers>
                    <Trigger Property="Validation.HasError" Value="True">
                        <Setter Property="ToolTip"
                                Value="{Binding (Validation.Errors)[0].ErrorContent, RelativeSource={RelativeSource Self}}" />
                        <Setter Property="ToolTipService.ShowDuration" Value="60000" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </Window.InputBindings>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Создание нового проекта"
                   Style="{StaticResource KPLN_TextBlock}"
                   FontSize="22"
                   FontWeight="Bold"
                   Margin="6,4,6,12" />

        <Border Grid.Row="1" Style="{StaticResource KPLN_CardBorder}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid Margin="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Имя проекта" Style="{StaticResource FormLabel}" />
                    <TextBox Grid.Column="1"
                             Style="{StaticResource KPLN_TextBox}"
                             Text="{Binding DBPrjWrapper.WrName, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="1" Text="Код проекта" Style="{StaticResource FormLabel}" />
                    <TextBox Grid.Row="1" Grid.Column="1"
                             Style="{StaticResource KPLN_TextBox}"
                             Text="{Binding DBPrjWrapper.WrCode, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="2" Text="Стадия" Style="{StaticResource FormLabel}" />
                    <ComboBox Grid.Row="2" Grid.Column="1"
                              Style="{StaticResource CBX}"
                              ItemsSource="{Binding DBPrjWrapper.WrStageColl}"
                              SelectedItem="{Binding DBPrjWrapper.WrStage}" />

                    <TextBlock Grid.Row="3" Text="Версия Revit" Style="{StaticResource FormLabel}" />
                    <TextBox Grid.Row="3" Grid.Column="1"
                             Style="{StaticResource KPLN_TextBox}"
                             Text="{Binding DBPrjWrapper.WrRevitVersion, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="4" Text="Папка стадии на сервере" Style="{StaticResource FormLabel}" />
                    <Grid Grid.Row="4" Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource ValidatedTextBox}"
                                 Text="{Binding DBPrjWrapper.WrServerPath,
                                                UpdateSourceTrigger=PropertyChanged,
                                                ValidatesOnDataErrors=True}" />
                        <Button Grid.Column="1"
                                Content="Обзор"
                                Style="{StaticResource KPLN_Button}"
                                Command="{Binding SetServerPathCommand}" />
                    </Grid>

                    <TextBlock Grid.Row="5" Text="Revit Server #1" Style="{StaticResource FormLabel}" />
                    <TextBox Grid.Row="5" Grid.Column="1"
                             Style="{StaticResource ValidatedTextBox}"
                             Text="{Binding DBPrjWrapper.WrRevitServerPath,
                                            UpdateSourceTrigger=PropertyChanged,
                                            ValidatesOnDataErrors=True}" />

                    <TextBlock Grid.Row="6" Text="Revit Server #2" Style="{StaticResource FormLabel}" />
                    <TextBox Grid.Row="6" Grid.Column="1"
                             Style="{StaticResource ValidatedTextBox}"
                             Text="{Binding DBPrjWrapper.WrRevitServerPath2,
                                            UpdateSourceTrigger=PropertyChanged,
                                            ValidatesOnDataErrors=True}" />

                    <TextBlock Grid.Row="7" Text="Revit Server #3" Style="{StaticResource FormLabel}" />
                    <TextBox Grid.Row="7" Grid.Column="1"
                             Style="{StaticResource ValidatedTextBox}"
                             Text="{Binding DBPrjWrapper.WrRevitServerPath3,
                                            UpdateSourceTrigger=PropertyChanged,
                                            ValidatesOnDataErrors=True}" />

                    <TextBlock Grid.Row="8" Text="Revit Server #4" Style="{StaticResource FormLabel}" />
                    <TextBox Grid.Row="8" Grid.Column="1"
                             Style="{StaticResource ValidatedTextBox}"
                             Text="{Binding DBPrjWrapper.WrRevitServerPath4,
                                            UpdateSourceTrigger=PropertyChanged,
                                            ValidatesOnDataErrors=True}" />
                </Grid>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Отмена"
                    Style="{StaticResource KPLN_Button}"
                    Background="#555B66"
                    BorderBrush="#555B66"
                    Command="{Binding CancelCommand}" />
            <Button Content="Создать проект"
                    Style="{StaticResource KPLN_Button}"
                    Command="{Binding CreateDBProjectCommand}" />
        </StackPanel>
    </Grid>
</Window>
