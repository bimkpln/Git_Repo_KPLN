<Window x:Class="KPLN_ViewsAndLists_CopyByLevels.Forms.CopyByLevelsForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:entities="clr-namespace:KPLN_ViewsAndLists_CopyByLevels.Forms.Entities"
        Title="KPLN: Листы по этажам — бета 0.1" Width="1260" Height="800" MinWidth="1000" MinHeight="650"
        WindowStartupLocation="CenterOwner" Background="#2B2F38" Foreground="#EDEDED" FontFamily="Segoe UI" FontSize="14">
    <Window.Resources><ResourceDictionary Source="Styles.xaml" /></Window.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Style="{StaticResource FormText}" Text="Листы по этажам" FontSize="24" FontWeight="SemiBold" Margin="6,0,6,10"/>
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="125"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource FormText}" Text="Эталонный лист" VerticalAlignment="Center"/>
            <ComboBox Grid.Column="1" ItemsSource="{Binding Sheets}" SelectedItem="{Binding SelectedSheet}" DisplayMemberPath="Name"/>
            <TextBlock Style="{StaticResource FormText}" Grid.Column="2" Text="Основной план" VerticalAlignment="Center" Margin="12,0,0,0"/>
            <ComboBox Grid.Column="3" ItemsSource="{Binding Plans}" SelectedItem="{Binding SelectedPlan}" DisplayMemberPath="Name"/>
        </Grid>
        <TabControl x:Name="Tabs" Grid.Row="2" Background="#333840" BorderThickness="0">
            <TabItem Header="1. Этажи">
                <Grid Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource Hint}" Text="Уровни выше основного плана. Автовыбор — предварительные галочки; технические уровни, корпус и обозначения этажей проверьте вручную. Типовые этажи — подпись листа, экспликация остаётся по выбранному уровню."/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal">
                        <TextBlock Style="{StaticResource FormText}" Text="Минимальный шаг, м:" VerticalAlignment="Center" Margin="6"/>
                        <TextBox Width="70" Text="{Binding Gap, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Content="Автовыбор" Command="{Binding AutoSelectCommand}"/>
                        <Button Content="Выбрать все" Command="{Binding SelectAllCommand}"/>
                        <Button Content="Снять все" Command="{Binding ClearSelectionCommand}"/>
                    </StackPanel>
                    <DataGrid x:Name="LevelsGrid" Grid.Row="2" ItemsSource="{Binding Model.Levels}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="✓" SortMemberPath="Selected" Width="45">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn ElementStyle="{StaticResource DG_TC}" EditingElementStyle="{StaticResource KPLN_TextBox}" Header="Уровень" Binding="{Binding Name}" IsReadOnly="True" Width="230"/>
                            <DataGridTextColumn ElementStyle="{StaticResource DG_TC}" EditingElementStyle="{StaticResource KPLN_TextBox}" Header="Отметка, м" Binding="{Binding Elevation}" IsReadOnly="True" Width="100"/>
                            <DataGridTextColumn ElementStyle="{StaticResource DG_TC}" EditingElementStyle="{StaticResource KPLN_TextBox}" Header="Этаж" Binding="{Binding Floor, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                            <DataGridTextColumn ElementStyle="{StaticResource DG_TC}" EditingElementStyle="{StaticResource KPLN_TextBox}" Header="Подпись типовых этажей" Binding="{Binding Group, UpdateSourceTrigger=PropertyChanged}" Width="200"/>
                            <DataGridTextColumn ElementStyle="{StaticResource DG_TC}" EditingElementStyle="{StaticResource KPLN_TextBox}" Header="Существующие планы" Binding="{Binding Existing}" IsReadOnly="True" Width="230"/>
                            <DataGridTextColumn ElementStyle="{StaticResource DG_TC}" EditingElementStyle="{StaticResource KPLN_TextBox}" Header="Проверить" Binding="{Binding Hint}" IsReadOnly="True" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="2. Состав листа">
                <Grid Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource Hint}" Text="Штамп копируется всегда. Аннотации непосредственно на листе — по галочке ниже. Общие легенды сохраняют связь с исходным видом. Независимая копия разреза или узла сохраняет исходную область модели. Для переменного узла можно выбрать другой вид."/>
                    <DataGrid x:Name="ContentsGrid" Grid.Row="1" ItemsSource="{Binding Model.ContentsForDisplay}">
                        <DataGrid.Columns>
                            <DataGridTextColumn ElementStyle="{StaticResource DG_TC}" EditingElementStyle="{StaticResource KPLN_TextBox}" Header="Вид эталона" Binding="{Binding Name}" IsReadOnly="True" Width="*"/>
                            <DataGridTextColumn ElementStyle="{StaticResource DG_TC}" EditingElementStyle="{StaticResource KPLN_TextBox}" Header="Тип" Binding="{Binding Kind}" IsReadOnly="True" Width="110"/>
                            <DataGridTemplateColumn Header="Действие" Width="220"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                                <ComboBox ItemsSource="{Binding Actions}" SelectedItem="{Binding Action, UpdateSourceTrigger=PropertyChanged}"/>
                            </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Вид для замены" Width="300"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                                <ComboBox ItemsSource="{Binding Replacements}" SelectedItem="{Binding Replacement}" DisplayMemberPath="Name"
                                          ToolTip="Доступно для действия «Другой существующий вид»." ToolTipService.ShowOnDisabled="True">
                                    <ComboBox.Style>
                                        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                            <Setter Property="IsEnabled" Value="False"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Action}" Value="{x:Static entities:CopyActions.Replace}">
                                                    <Setter Property="IsEnabled" Value="True"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ComboBox.Style>
                                </ComboBox>
                            </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="2">
                        <CheckBox Content="Копировать аннотации, размещённые на листе"
                                  ToolTip="Тексты, аннотационные семейства, линии, области, изображения и группы оформления непосредственно на листе. Штамп копируется всегда."
                                  IsChecked="{Binding Model.CopySheetAnnotations, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Checked="OptionsChanged" Unchecked="OptionsChanged"/>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="3. Экспликации">
                <Grid Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource Hint}" Text="Для каждой этажной спецификации оставьте независимую копию и настройте изменяемые условия. Для общей таблицы снимите флажок копии. Неотмеченные фильтры, поля, сортировка и оформление сохраняются."/>
                    <DataGrid x:Name="SchedulesGrid" Grid.Row="1" ItemsSource="{Binding Model.Schedules}" MouseDoubleClick="EditFilters">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Разместить" SortMemberPath="Include" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Include, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Независимая копия" SortMemberPath="Copy" Width="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Copy, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn ElementStyle="{StaticResource DG_TC}" EditingElementStyle="{StaticResource KPLN_TextBox}" Header="Спецификация" Binding="{Binding Name}" IsReadOnly="True" Width="*"/>
                            <DataGridTextColumn ElementStyle="{StaticResource DG_TC}" EditingElementStyle="{StaticResource KPLN_TextBox}" Header="Условия" Binding="{Binding Filters.Count}" IsReadOnly="True" Width="80"/>
                            <DataGridTextColumn ElementStyle="{StaticResource DG_TC}" EditingElementStyle="{StaticResource KPLN_TextBox}" Header="Шаблон" Binding="{Binding Hint}" IsReadOnly="True" Width="300"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Button Grid.Row="2" Content="Настроить фильтры выбранной спецификации…" HorizontalAlignment="Left" Click="EditFilters"/>
                </Grid>
            </TabItem>
            <TabItem Header="4. Имена и предпросмотр">
                <Grid Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource FormText}" Text="Префикс номера:" VerticalAlignment="Center" Margin="6"/><TextBox Width="110" Text="{Binding NumberPrefix, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Style="{StaticResource FormText}" Text="Начать с:" VerticalAlignment="Center" Margin="6"/><TextBox Width="80" Text="{Binding StartNumber, UpdateSourceTrigger=PropertyChanged}"/>
                        <CheckBox Content="Пропускать ранее созданные этим плагином листы" IsChecked="{Binding Model.SkipExisting}" Checked="OptionsChanged" Unchecked="OptionsChanged"/>
                    </StackPanel>
                    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource FormText}" Text="Название листа:" VerticalAlignment="Center" Margin="6"/><TextBox Grid.Column="1" Text="{Binding SheetPattern, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource FormText}" Text="Имя плана:" VerticalAlignment="Center" Margin="6"/><TextBox Grid.Column="1" Text="{Binding ViewPattern, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                    <DockPanel Grid.Row="3">
                        <Button DockPanel.Dock="Right" Content="Сформировать предпросмотр" Click="BuildPreview"/>
                        <TextBlock Style="{StaticResource Hint}" Text="Маски: {Этаж}, {Уровень}, {Отметка}, {Типовые}, {Исходное}, {Индекс}. Названия и номера ниже можно исправить вручную. Повторное формирование заменяет ручные правки."/>
                    </DockPanel>
                    <DataGrid x:Name="PreviewGrid" Grid.Row="4" ItemsSource="{Binding Model.Preview}">
                        <DataGrid.Columns>
                            <DataGridTextColumn ElementStyle="{StaticResource DG_TC}" EditingElementStyle="{StaticResource KPLN_TextBox}" Header="Уровень" Binding="{Binding LevelName}" IsReadOnly="True" Width="160"/>
                            <DataGridTextColumn ElementStyle="{StaticResource DG_TC}" EditingElementStyle="{StaticResource KPLN_TextBox}" Header="№" Binding="{Binding Number, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                            <DataGridTextColumn ElementStyle="{StaticResource DG_TC}" EditingElementStyle="{StaticResource KPLN_TextBox}" Header="Название листа" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="280"/>
                            <DataGridTextColumn ElementStyle="{StaticResource DG_TC}" EditingElementStyle="{StaticResource KPLN_TextBox}" Header="Имя плана" Binding="{Binding ViewName, UpdateSourceTrigger=PropertyChanged}" Width="230"/>
                            <DataGridTextColumn ElementStyle="{StaticResource DG_TC}" EditingElementStyle="{StaticResource KPLN_TextBox}" Header="Фильтры" Binding="{Binding Filters}" IsReadOnly="True" Width="220"/>
                            <DataGridTextColumn ElementStyle="{StaticResource DG_TC}" EditingElementStyle="{StaticResource KPLN_TextBox}" Header="Проверка" Binding="{Binding Status}" IsReadOnly="True" Width="220"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
        <Border Grid.Row="3" Style="{StaticResource KPLN_CardBorder}" Padding="10" Margin="4,10,4,4" MaxHeight="120">
            <ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock Style="{StaticResource FormText}" Text="{Binding Status}" TextWrapping="Wrap"/></ScrollViewer>
        </Border>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Создать листы" Click="CreateSheets" IsEnabled="{Binding PreviewReady}" Padding="24,7"/>
            <Button Content="Закрыть" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
