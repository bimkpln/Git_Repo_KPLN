<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="KPLN_CalculateTEP.Forms.AR_CalculateTEP" Title="ТЭП | Расчёт по помещениям" Width="1240" Height="840" MinWidth="960" MinHeight="640" WindowStartupLocation="CenterOwner" Background="#F3F5F8" FontFamily="Segoe UI" FontSize="13" Language="ru-RU" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#233348"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#596B80"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,6,0,12"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="#E8EEF5"/>
            <Setter Property="Foreground" Value="#233348"/>
            <Setter Property="BorderBrush" Value="#B9C9DA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="#246FAE"/>
                                <Setter TargetName="Frame" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Frame" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="#147BCC"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Frame" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="MinHeight" Value="31"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="MinHeight" Value="31"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MaxDropDownHeight" Value="440"/>
            <Setter Property="ToolTip">
                <Setter.Value>
                    <MultiBinding StringFormat="{}{0}&#10;{1}">
                        <Binding Path="Tag" RelativeSource="{RelativeSource Self}"/>
                        <Binding Path="SelectedItem.Description" RelativeSource="{RelativeSource Self}"/>
                    </MultiBinding>
                </Setter.Value>
            </Setter>
            <Setter Property="ToolTipService.ShowDuration" Value="60000"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="ToolTip" Value="{Binding Description}"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="250"/>
            <Setter Property="ToolTipService.ShowDuration" Value="60000"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
        <Style TargetType="ToolTip">
            <Setter Property="MaxWidth" Value="520"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D9E1EB"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E8EDF3"/>
            <Setter Property="BorderBrush" Value="#D8E1EA"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="RowHeight" Value="36"/>
            <Setter Property="ColumnHeaderHeight" Value="38"/>
            <Setter Property="AlternatingRowBackground" Value="#F7F9FC"/>
            <Setter Property="SelectionMode" Value="Extended"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="EnableColumnVirtualization" Value="True"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#EAF0F7"/>
            <Setter Property="Foreground" Value="#34475D"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="BorderBrush" Value="#D9E1EB"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,5,16,5"/>
        </Style>
    </Window.Resources>
    <Grid Margin="22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <WrapPanel x:Name="HeaderActions" Margin="0,0,0,12" VerticalAlignment="Center">
            <Button Content="Импорт JSON" Click="Import_Click" ToolTip="Загружает настройки из JSON вместо текущих. После импорта проверьте соответствие параметров и источников этой модели."/>
            <Button Content="Экспорт JSON" Click="ExportSettings_Click" ToolTip="Сохраняет текущие настройки в выбранный JSON для переноса в другую модель."/>
            <Button Content="Сохранить в RVT" Click="Save_Click" ToolTip="{Binding Engine.StorageDescription}" Margin="0"/>
        </WrapPanel>
        <TabControl x:Name="Steps" Grid.Row="1" Background="Transparent" BorderBrush="#D9E1EB">
            <TabItem Header="1. Показатели" x:Name="IndicatorsTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <GroupBox Header="Методика и профиль здания">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Расчёт ГНС"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding Methods}" DisplayMemberPath="Label" SelectedValuePath="Key" SelectedValue="{Binding Config.Method}" Tag="Выберите методику ГНС. Меняет правила наружного контура, проёмов, шахт, террас и эксплуатируемой кровли; различия указаны у вариантов списка." x:Name="MethodSelector"/>
                                <TextBlock Grid.Column="3" Text="Тип здания"/>
                                <ComboBox Grid.Column="4" ItemsSource="{Binding Profiles}" DisplayMemberPath="Label" SelectedValuePath="Key" SelectedValue="{Binding Config.Profile}" Tag="Тип здания определяет правила включения помещений и этажей. Параметр типа здания у помещения может уточнять этот выбор." x:Name="ProfileSelector"/>
                                <TextBlock Grid.Row="2" Grid.ColumnSpan="5" Text="Выберите методику ГНС и тип здания, затем отметьте нужные показатели ниже. От выбора зависят учитываемые помещения, этажи и исключения." Style="{StaticResource Hint}" Margin="0,10,0,0"/>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,12" Text="{Binding SelectedItem.Description, ElementName=MethodSelector}" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"/>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,12" Text="{Binding SelectedItem.Description, ElementName=ProfileSelector}" Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="2"/>
                            </Grid>
                        </GroupBox>
                        <TextBlock Text="Показатели расчёта" Style="{StaticResource Caption}"/>
                        <DockPanel Margin="0,0,0,10">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Выбрать всё" Click="SelectAll_Click" ToolTip="Включает все показатели расчёта и их подгруппы."/>
                                <Button Content="Снять всё" Click="SelectNone_Click" Margin="0" ToolTip="Отключает все показатели. Перед расчётом включите необходимые."/>
                            </StackPanel>
                            <TextBlock Text="25 показателей и подгрупп" FontSize="16" FontWeight="SemiBold"/>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Config.Metrics}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" BorderBrush="#E1E7EF" BorderThickness="0,0,0,1" Padding="12,6">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="65"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Content="{Binding Name}" IsChecked="{Binding Enabled}" ToolTip="{Binding Description}" Checked="Metric_Checked" ToolTipService.ShowDuration="60000"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Unit}" HorizontalAlignment="Right" Foreground="#607187"/>
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Hint}" Margin="0,0,0,6" Grid.Row="1" Grid.ColumnSpan="2"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="2. Помещения">
                <TabControl x:Name="RoomTabs" Margin="12">
                    <TabItem Header="Параметры">
                        <Grid Margin="14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <WrapPanel>
                                    <TextBlock Text="Помещения основной модели и загруженных связей" FontWeight="SemiBold" Margin="0,0,18,0"/>
                                    <TextBlock Text="Стадия" Margin="18,0,10,0"/>
                                    <ComboBox Width="160" IsEditable="True" ItemsSource="{Binding Engine.Phases}" Text="{Binding Config.Phase}" ToolTip="Выберите или введите имя стадии. В расчёт входят существующие и новые объекты этой стадии; пусто - последняя стадия каждого источника.&#10;Пример: Новое строительство"/>
                                </WrapPanel>
                                <TextBlock Text="Стадия определяет, какие помещения и конструкции учитывать. Пусто - последняя стадия каждого источника.&#10;Пример: «Новое строительство». После заполнения параметров нажмите «Проверить помещения»: ошибки покажут, какие показатели недоступны. При запуске остальные показатели рассчитываются автоматически." Style="{StaticResource Hint}" Margin="0,8,0,0"/>
                            </StackPanel>
                            <DockPanel Grid.Row="1" Margin="0,12">
                                <Button DockPanel.Dock="Right" Content="Проверить помещения" Click="Check_Click" Margin="0" ToolTip="Проверяет все расчётные помещения, параметры, заполненность и распределение назначений до построения геометрии. Коэффициенты доступны после сканирования. При ошибках показывает список объектов и доступность показателей; независимые показатели можно рассчитать."/>
                                <TextBlock Text="Основные параметры и правило жилой части закреплены в расчёте. Здесь задайте только параметры особых нормативных проверок, применимые к модели. Пустое имя означает, что параметр не задан." TextWrapping="Wrap" Margin="0,0,15,0"/>
                            </DockPanel>
                            <DataGrid x:Name="ParametersGrid" Grid.Row="2" ItemsSource="{Binding RoomParameters}"/>
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="ClassificationTab" Header="Классификация">
                        <Grid Margin="18">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Сканировать помещения" Click="ScanRooms_Click" Margin="12,0,0,0" ToolTip="Читает системное «Назначение» только у размещённых помещений текущей стадии основной модели и загруженных связей. Точное совпадение с названием категории без учёта регистра распределяется автоматически. Остальное попадает в нераспределённые; ручные назначения сохраняются."/>
                                <TextBlock Text="Распределение назначений" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <StackPanel Grid.Row="1" Margin="0,8,0,12">
                                <TextBlock Text="Точное совпадение «Назначения» с названием категории без учёта регистра распределяется автоматически. Остальные значения - в «Нераспределённых». «Квартира» всегда относится к жилым помещениям квартиры. Для остальных значений ручное распределение имеет приоритет, включая возврат в нераспределённые. Нажмите карточку, выберите значения и назначьте категорию справа. Число в скобках - количество размещённых помещений. Неразмещённые помещения пропускаются. Размещённые помещения с нулевой площадью остаются в классификации; их ошибки показываются перед расчётом." Style="{StaticResource Hint}"/>
                                <TextBlock x:Name="ClassificationScanText" Text="Помещения ещё не просканированы." Margin="0,6,0,0" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="5*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="4*"/></Grid.ColumnDefinitions>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <WrapPanel x:Name="CategoryCards"/>
                                </ScrollViewer>
                                <Grid Grid.Column="2">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="3*"/></Grid.RowDefinitions>
                                    <TextBlock x:Name="CategoryTitle" Text="Нераспределённые" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="CategoryDescription" Grid.Row="1" Style="{StaticResource Hint}" Margin="0,6,0,10"/>
                                    <ListBox x:Name="DepartmentValues" Grid.Row="2" SelectionMode="Extended" DisplayMemberPath="Caption" SelectionChanged="DepartmentValues_Changed" MinHeight="85" ToolTip="Уникальные значения «Назначения» в выбранной категории. Ctrl / Shift позволяют выбрать несколько значений. Ниже показаны помещения выбранных значений; без выбора - все помещения карточки."/>
                                    <TextBlock Grid.Row="3" Text="Отнести выбранные значения к категории:" Margin="0,10,0,6" TextWrapping="Wrap"/>
                                    <ComboBox x:Name="DepartmentTarget" Grid.Row="4" ItemsSource="{Binding DepartmentRoles}" DisplayMemberPath="Label" SelectedValuePath="Key" SelectedIndex="0" Tag="Выберите расчётную категорию. Она определяет включение всех помещений с выбранным назначением в показатели старой и новой методики. «Нераспределённые» снимает назначенную категорию."/>
                                    <DockPanel Grid.Row="5" Margin="0,8,0,8">
                                        <Button x:Name="AssignDepartmentButton" DockPanel.Dock="Right" Content="Распределить" Click="AssignDepartment_Click" Margin="8,0,0,0" IsEnabled="False" ToolTip="Переносит выбранные значения назначения и все их помещения в указанную категорию. Назначение «Квартира» закреплено в расчёте и не переносится. Параметры модели не изменяются. Распределение сохраняется вместе с настройками ТЭП."/>
                                        <TextBlock x:Name="DepartmentRoomsTitle" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    </DockPanel>
                                    <DataGrid x:Name="DepartmentRoomsGrid" Grid.Row="6" IsReadOnly="True"/>
                                </Grid>
                            </Grid>
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="RoomOptionsTab" Header="Квартиры, этажи и отметки" ToolTip="Коэффициенты квартир, отметки земли и нуля, состав этажей. Коэффициенты доступны после сканирования помещений; настройки этажей доступны сразу.">
                        <ScrollViewer x:Name="RoomOptionsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="20">
                            <TextBlock Text="Квартиры и коэффициенты" Style="{StaticResource Caption}"/>
                            <TextBlock x:Name="RoomScanText" TextWrapping="Wrap" Margin="0,0,0,18"/>
                            <TextBlock Text="Квартиры группируются по корпусу, секции и сквозному номеру / ID. Этаж не разделяет одну квартиру. Номера разных квартир в одной секции должны различаться." TextWrapping="Wrap" Margin="0,0,0,18"/>
                            <Grid x:Name="CoefficientInputs" IsEnabled="False">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Коэффициент лоджий" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Margin="0,0,0,12" Text="{Binding Config.LoggiaCoefficient}" ToolTip="Число от 0 до 1. Умножает площадь лоджий при расчёте общей площади квартир с летними помещениями. На исходную площадь и ГНС не влияет.&#10;Пример: 0,5"/>
                                <TextBlock Grid.Row="1" Text="Балконы и террасы" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Config.BalconyCoefficient}" ToolTip="Число от 0 до 1. Умножает площадь балконов и террас при расчёте общей площади квартир с летними помещениями. Применяется один раз, без коэффициентов из параметров и правил.&#10;Пример: 0,3"/>
                            </Grid>
                            <TextBlock Text="Коэффициенты меняют только общую площадь квартир с летними помещениями. Площадь без летних помещений и ГНС от этих значений не меняются.&#10;Пример: лоджия 6 м² × 0,5 = 3 м²; балкон 6 м² × 0,3 = 1,8 м². Введите число от 0 до 1." Style="{StaticResource Hint}" Margin="0,16,0,0"/>
                        <Grid Margin="0,24,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Высотные отметки и состав этажей" Style="{StaticResource Caption}"/>
                            <GroupBox Grid.Row="1" Header="Ноль здания и уровень земли">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Первый этаж (ноль здания)" TextWrapping="Wrap" Margin="0,0,10,0"/>
                                        <ComboBox x:Name="FirstFloorLevel" Grid.Column="1" ItemsSource="{Binding ZeroLevels}" DisplayMemberPath="DatumDisplayName" SelectedValuePath="Key" SelectedValue="{Binding Config.ZeroLevel}" ToolTip="Выберите уровень первого этажа. Ноль здания принимается по этому уровню; в списке указана абсолютная отметка в общих координатах основной модели. Для связи учтено её размещение. Ноль разделяет строительный объём на надземную и подземную части."/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Column="1" Text="Способ" Margin="0,0,10,6"/>
                                        <TextBlock Grid.Column="2" Text="Отметка, м"/>
                                        <TextBlock Grid.Column="3" Text="Уровень"/>
                                        <TextBlock Grid.Column="4" Text="Параметр проекта"/>
                                        <TextBlock Grid.Row="1" Text="Уровень земли"/>
                                        <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,10,0" ItemsSource="{Binding DatumModes}" DisplayMemberPath="Label" SelectedValuePath="Key" SelectedValue="{Binding Config.GroundMode}" Tag="Выберите источник отметки земли. Отметка влияет на наземность этажей и площадь застройки."/>
                                        <TextBox Grid.Row="1" Grid.Column="2" Margin="0,0,10,0" Text="{Binding Config.GroundValue}" ToolTip="Введите абсолютную отметку земли в метрах в координатах основной модели. В ручном режиме определяет наземность этажей и сечение площади застройки.&#10;Пример: 155,80"/>
                                        <ComboBox Grid.Row="1" Grid.Column="3" Margin="0,0,10,0" ItemsSource="{Binding Config.Levels}" DisplayMemberPath="DisplayName" SelectedValuePath="Key" SelectedValue="{Binding Config.GroundLevel}" Tag="Выберите уровень земли. Его отметка используется при способе отсчёта «Уровень»."/>
                                        <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding Config.GroundParameter}" ToolTip="Введите точное имя параметра сведений о проекте с отметкой земли. Читается в режиме «Параметр» и влияет на наземность и площадь застройки.&#10;Пример: ТЭП_Отметка земли"/>
                                    </Grid>
                                    <TextBlock Text="Ноль здания берётся из выбранного уровня первого этажа. Его абсолютная отметка показана в списке; вводить её вручную не нужно. Земля определяет наземность этажей и сечение площади застройки.&#10;Для земли способ «Вручную» - введите абсолютную отметку в метрах; «Уровень» - выберите уровень; «Параметр» - укажите имя параметра сведений о проекте. Заполняйте поля выбранного способа.&#10;Пример для земли: отметка 155,80 м в координатах основной модели; параметр «ТЭП_Отметка земли»." Style="{StaticResource Hint}" Margin="0,10,0,0"/>
                                </StackPanel>
                            </GroupBox>
                            <DockPanel Grid.Row="2" Margin="0,0,0,12">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="Уточнить для секции" Click="SectionLevel_Click" ToolTip="Копирует выбранный уровень для отдельного корпуса или секции. Позволяет уточнить наземность и геометрию этажа на уклоне."/>
                                    <Button Content="Удалить уточнение" Click="DeleteSectionLevel_Click" Margin="0" ToolTip="Удаляет выбранные уточнения уровня по корпусу или секции; общая настройка уровня сохраняется."/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,0,16,0" Text="Для цоколя укажите верх перекрытия. На уклоне уточните наземность по корпусу / секции. Высоты в метрах, доля кровли - от 0 до 1."/>
                            </DockPanel>
                            <Grid Grid.Row="3">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Expander Header="Как заполнить таблицу этажей" IsExpanded="False" Margin="0,0,0,8">
                                    <TextBlock Text="«Учесть» включает этаж в расчёт. «Вид этажа» задаёт нормативные правила; «Наземность» уточняет положение относительно земли.&#10;Для цоколя укажите абсолютную отметку верха перекрытия; для технических этажей и надстроек - применимые высоту, долю кровли и площадь надстройки.&#10;Пример: высота 2,4 м; доля кровли 0,2 означает 20%; площадь надстройки 12 м².&#10;Корпус и секция уточнения заполняются только для отдельных настроек участка уровня. «Уточнить для секции» создаёт такую строку. Пример: корпус 2, секция 1." Style="{StaticResource Hint}" Margin="0,6,0,12"/>
                                </Expander>
                                <DataGrid x:Name="LevelsGrid" Height="300" Grid.Row="1" ItemsSource="{Binding Config.Levels}"/>
                            </Grid>
                        </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </TabItem>
            <TabItem Header="3. Результат" x:Name="ResultsTab">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,12">
                        <WrapPanel DockPanel.Dock="Right">
                            <ComboBox Width="130" Margin="0,0,12,0" ItemsSource="{Binding DiagnosticModes}" DisplayMemberPath="Label" SelectedValuePath="Key" SelectedValue="{Binding Config.IssueDetail}" SelectionChanged="DiagnosticMode_Changed" Tag="Выберите подробность списка ошибок. Меняет группировку сообщений в отчёте, сохраняя полный расчёт."/>
                            <Button Content="К объекту / виду" Click="Navigate_Click" ToolTip="Переходит к выбранному объекту или служебному виду из детализации или ошибки."/>
                            <Button Content="Экспорт XLSX / CSV" Click="ExportRun_Click" Margin="0" ToolTip="Сохраняет последний расчёт и диагностику в выбранный XLSX или CSV."/>
                        </WrapPanel>
                        <TextBlock x:Name="ReportStatus" Text="Выполните расчёт или откройте сохранённый результат" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,16,0"/>
                    </DockPanel>
                    <TabControl Grid.Row="1" x:Name="ReportTabs">
                        <TabItem Header="Итоги">
                            <DockPanel>
                                <TextBlock Text="Итог по каждому выбранному показателю. Результат с ошибками требует проверки; подробности находятся во вкладке «Ошибки и проверки»." Style="{StaticResource Hint}" Margin="10,8,10,10" DockPanel.Dock="Top"/>
                                <DataGrid x:Name="SummaryGrid" IsReadOnly="True"/>
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="По этажам">
                            <DockPanel>
                                <TextBlock Text="Площади каждого этажа по корпусам и секциям. Текст можно выделить и скопировать." Style="{StaticResource Hint}" Margin="10,8,10,10" DockPanel.Dock="Top"/>
                                <RichTextBox x:Name="FloorReport" IsReadOnly="True" IsDocumentEnabled="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="White" FontFamily="Consolas" FontSize="13" ToolTip="Поэтажная расшифровка последнего расчёта: площадь каждого этажа по корпусу и секции. Текст можно выделить и скопировать."/>
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="Объекты">
                            <DockPanel>
                                <TextBlock Text="Из каких помещений и элементов получен итог: исходная площадь, коэффициент, учтённое значение и причина исключения. Выберите строку для перехода к объекту." Style="{StaticResource Hint}" Margin="10,8,10,10" DockPanel.Dock="Top"/>
                                <DataGrid x:Name="DetailsGrid" IsReadOnly="True" MouseDoubleClick="Details_DoubleClick"/>
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="Ошибки и проверки">
                            <DockPanel>
                                <TextBlock Text="Что помешало расчёту и какие данные проверить. Ошибки выделены красным. Двойной щелчок по сообщению с ID открывает соответствующий объект." Style="{StaticResource Hint}" Margin="10,8,10,10" DockPanel.Dock="Top"/>
                                <DataGrid x:Name="IssuesGrid" IsReadOnly="True" MouseDoubleClick="Issues_DoubleClick"/>
                            </DockPanel>
                        </TabItem>
                    </TabControl>
                </Grid>
            </TabItem>
        </TabControl>
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Row="1" Margin="0,0,20,0" VerticalAlignment="Center">
                <TextBlock x:Name="Status" Text="Загрузка модели..." TextWrapping="Wrap" Foreground="#596B80"/>
                <ProgressBar x:Name="WorkProgress" Height="5" Margin="0,7,0,0" IsIndeterminate="True" Visibility="Collapsed" ToolTip="Идёт обработка модели. Текущий этап и число обработанных объектов показаны над полосой."/>
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="CancelButton" Content="Отменить" Click="Cancel_Click" Visibility="Collapsed" ToolTip="Отменяет работу после текущей операции Revit. Изменения этого расчёта откатываются, предыдущий отчёт сохраняется."/>
                <Button x:Name="CalculateButton" Content="Рассчитать ТЭП" Click="Calculate_Click" Background="#245C91" Foreground="White" FontWeight="SemiBold" MinWidth="150" Margin="8,0,0,0" ToolTip="Проверяет настройки, предупреждает о недостающих данных и автоматически рассчитывает доступные показатели. Недоступные показатели отмечает в результате с причиной. Прогресс показан слева; расчёт можно отменить."/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>