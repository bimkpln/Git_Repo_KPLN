<Window x:Class="KPLN_ModelChecker_User.Forms.CheckListAnnotationsSettingsForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:KPLN_ModelChecker_User.Forms.Converters"
        Title="[KPLN]: Настройки проверки аннотаций"
        Width="500"
        Height="440"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        WindowStartupLocation="CenterOwner"
        FontFamily="Monaco, Consolas, 'Andale Mono', 'DejaVu Sans Mono', monospace"
        Background="#FFF5F5F5"
        ShowInTaskbar="False">

    <Window.InputBindings>
        <KeyBinding
            Key="Escape"
            Command="{Binding CloseWindowCmd}"
            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />
    </Window.InputBindings>

    <Window.Resources>
        <conv:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF242424"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="HeaderTextStyle"
               TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="DescriptionTextStyle"
               TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF666666"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#FF242424"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,5,0,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FF242424"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="BaseButtonStyle"
               TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="14,4"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#FF55585C"/>
            <Setter Property="BorderBrush" Value="#FF44474A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#FFE59400"/>
                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#FF00A957"/>
                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="#FF4C87B3"/>
            <Setter Property="MinWidth" Value="105"/>
        </Style>

        <Style x:Key="SecondaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="MinWidth" Value="105"/>
        </Style>

        <Style x:Key="DangerButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="#FF9B4A4A"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,12">

            <TextBlock Style="{StaticResource HeaderTextStyle}"
                       Text="Настройки проверки аннотаций"/>

            <TextBlock Style="{StaticResource DescriptionTextStyle}"
                       Text="Выберите, как показывать найденные недопустимые аннотации после завершения проверки."/>
        </StackPanel>

        <Border Grid.Row="1"
                Padding="14"
                Background="White"
                BorderBrush="#FFD7D7D7"
                BorderThickness="1"
                CornerRadius="6"
                DataContext="{Binding CurrentCheckListAnnotationsSettingsM}">

            <StackPanel>
                <TextBlock Margin="0,0,0,6"
                           FontWeight="Bold"
                           Text="Отображение найденных элементов"/>

                <RadioButton GroupName="DisplayMode"
                             Content="Выделять элементы"
                             IsChecked="{Binding DisplayMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=SelectElements}"/>

                <TextBlock Margin="24,0,0,8"
                           Style="{StaticResource DescriptionTextStyle}"
                           Text="Стандартное выделение элементов средствами Revit."/>

                <RadioButton GroupName="DisplayMode"
                             Content="Окрашивать элементы"
                             IsChecked="{Binding DisplayMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=HighlightElements}"/>

                <TextBlock Margin="24,0,0,8"
                           Style="{StaticResource DescriptionTextStyle}"
                           Text="Для найденных элементов будут установлены переопределения графики на соответствующих видах."/>

                <Grid Margin="24,2,0,10"
                      IsEnabled="{Binding IsHighlightMode}">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Grid.Column="0"
                                   Margin="0,0,10,0"
                                   FontWeight="Bold"
                                   Text="Цвет:"/>

                        <Button Grid.Column="1"
                                HorizontalAlignment="Left"
                                Height="34"
                                Padding="8,3"
                                Background="White"
                                BorderBrush="#FFAAAAAA"
                                BorderThickness="1"
                                Command="{Binding DataContext.ChooseColorCmd, RelativeSource={RelativeSource AncestorType=Window}}">

                            <StackPanel Orientation="Horizontal">
                                <Border Width="36"
                                        Height="20"
                                        Margin="0,0,8,0"
                                        BorderBrush="#FF555555"
                                        BorderThickness="1"
                                        CornerRadius="2"
                                        Background="{Binding HighlightColorBrush}"/>

                                <TextBlock MinWidth="85"
                                           Foreground="#FF242424"
                                           VerticalAlignment="Center"
                                           Text="{Binding HighlightColorText}"/>
                            </StackPanel>
                        </Button>
                        <CheckBox Margin="0,2,0,0"
                                  Content="Снимать предыдущую окраску перед новой проверкой"
                                  IsChecked="{Binding ClearPreviousHighlight}"/>
                    </StackPanel>

                </Grid>

                <Separator Margin="0,4,0,10"/>

                <Button HorizontalAlignment="Left"
                        Style="{StaticResource DangerButtonStyle}"
                        Content="Снять текущее окрашивание"
                        Command="{Binding DataContext.ClearHighlightCmd, RelativeSource={RelativeSource AncestorType=Window}}"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="2"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Content="Сохранить"
                    IsDefault="True"
                    Command="{Binding SaveWindowCmd}"/>
        </Grid>
    </Grid>
</Window>