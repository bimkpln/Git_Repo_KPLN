<Window x:Class="KPLN_Clashes_Ribbon.Forms.ZoomSettingsForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KPLN: Настройки зума"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="380"
        Background="#FF292D36"
        FontFamily="Consolas, 'Segoe UI', monospace"
        WindowStyle="ToolWindow">
    <Window.InputBindings>
        <KeyBinding
            Key="Escape"
            Command="{Binding CloseWindowCmd}"
            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />
    </Window.InputBindings>

    <Window.Resources>
        <Style x:Key="MainTBL" TargetType="TextBlock">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="TXTBX" TargetType="TextBox">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="MinHeight" Value="22"/>
            <Setter Property="Width" Value="95"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>
        <Style x:Key="MainBTN" TargetType="Button">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{x:Null}"/>
            <Setter Property="BorderBrush" Value="White"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CHB" TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="5,10,5,5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid DataContext="{Binding CurrentZoomSettingsM}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Расширение X, мм:" Style="{StaticResource MainTBL}"/>
            <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource TXTBX}" Text="{Binding OffsetXMillimetersText, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Grid.Row="0" Grid.Column="2" Text="+/-" Style="{StaticResource MainTBL}" Opacity="0.65"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Расширение Y, мм:" Style="{StaticResource MainTBL}"/>
            <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource TXTBX}" Text="{Binding OffsetYMillimetersText, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Grid.Row="1" Grid.Column="2" Text="+/-" Style="{StaticResource MainTBL}" Opacity="0.65"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Расширение Z вниз, мм:" Style="{StaticResource MainTBL}"/>
            <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource TXTBX}" Text="{Binding OffsetZMinMillimetersText, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Расширение Z вверх, мм:" Style="{StaticResource MainTBL}"/>
            <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource TXTBX}" Text="{Binding OffsetZMaxMillimetersText, UpdateSourceTrigger=PropertyChanged}"/>

            <CheckBox Grid.Row="4"
                      Grid.Column="0"
                      Grid.ColumnSpan="3"
                      Style="{StaticResource CHB}"
                      Content="Вписывать коллизию"
                      IsChecked="{Binding FitCollision}"/>

            <TextBlock Grid.Row="5"
                       Grid.Column="0"
                       Grid.ColumnSpan="3"
                       Style="{StaticResource MainTBL}"
                       FontSize="10"
                       Foreground="Red"
                       MinHeight="22"
                       Text="{Binding UserHelp}"/>
        </Grid>

        <DockPanel Grid.Row="2" LastChildFill="False" Margin="0,10,0,0">
            <Button Content="По умолчанию" Style="{StaticResource MainBTN}" Command="{Binding DropToDefaultCmd}"/>
            <Button Content="Применить" Style="{StaticResource MainBTN}" Command="{Binding SaveConfigCmd}"/>
            <Button Content="Отмена"
                    Style="{StaticResource MainBTN}"
                    Command="{Binding CloseWindowCmd}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
        </DockPanel>
    </Grid>
</Window>

