<Window x:Class="KPLN_Tools_AR.Forms.AR_TEPDesign_categorySelect" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Выбор категории" Height="255" Width="300" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="SingleBorderWindow" Topmost="False" ShowInTaskbar="False">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/KPLN_Library_Forms;component/UI/LibStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <Style TargetType="TextBlock" BasedOn="{StaticResource TXT}">
        <Setter Property="Margin" Value="0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="#202936" />
        <Setter Property="MaxWidth" Value="Infinity" />
      </Style>
      <Style TargetType="ComboBox" BasedOn="{StaticResource CBX}">
        <Setter Property="Margin" Value="0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="#202936" />
      </Style>
      <Style TargetType="RadioButton" BasedOn="{StaticResource RB}">
        <Setter Property="Margin" Value="0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="#202936" />
      </Style>
      <Style TargetType="CheckBox" BasedOn="{StaticResource CHB}">
        <Setter Property="Margin" Value="0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="#202936" />
      </Style>
      <Style TargetType="TextBox" BasedOn="{StaticResource KPLN_TextBox}">
        <Setter Property="Margin" Value="0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="#202936" />
        <Setter Property="Background" Value="White" />
        <Setter Property="CaretBrush" Value="#202936" />
      </Style>
      <Style TargetType="Button" BasedOn="{StaticResource BTN}">
        <Setter Property="Margin" Value="0" />
        <Setter Property="FontSize" Value="12" />
      </Style>
    </ResourceDictionary>
  </Window.Resources>
  <Grid Margin="10">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
      <Button Content="Помещения" Tag="1" Width="240" Height="30" Padding="10,0,0,0" Margin="0 0 0 5" HorizontalContentAlignment="Left" Click="CategoryButton_Click" />
      <Button Content="Зоны" Tag="3" Width="240" Height="30" Padding="10,0,0,0" Margin="0 0 0 5" HorizontalContentAlignment="Left" Click="CategoryButton_Click" />
      <Button Content="Цветовые области (элементы узлов)" Tag="2" Width="240" Height="30" Padding="10,0,0,0" Margin="0 0 0 5" HorizontalContentAlignment="Left" Click="CategoryButton_Click" />
      <Button Content="Формы (перекрытия)" Tag="4" Width="240" Height="30" Padding="10,0,0,0" HorizontalContentAlignment="Left" Click="CategoryButton_Click" />
      <Button Content="⚠️ Принудительное обновление стиля таблицы" Tag="4" Width="240" Height="30" Margin="0 20 0 0" Padding="10,0,0,0" HorizontalContentAlignment="Left" Click="UpdateTablleButton_Click" FontSize="9" Background="#FFFFF7DA" Foreground="#202936" />
    </StackPanel>
  </Grid>
</Window>