<Window x:Class="KPLN_Tools_SS.Forms.ScanProgressWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="KPLN. Сканирование скрытых элементов" Height="130" Width="460" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Topmost="False" WindowStyle="ToolWindow" ShowInTaskbar="False">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/KPLN_Library_Forms;component/UI/LibStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <Style TargetType="TextBlock" BasedOn="{StaticResource TXT}">
        <Setter Property="Margin" Value="0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="#202936" />
        <Setter Property="MaxWidth" Value="Infinity" />
      </Style>
      <Style TargetType="ComboBox" BasedOn="{StaticResource CBX}">
        <Setter Property="Margin" Value="0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="#202936" />
      </Style>
      <Style TargetType="RadioButton" BasedOn="{StaticResource RB}">
        <Setter Property="Margin" Value="0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="#202936" />
      </Style>
      <Style TargetType="CheckBox" BasedOn="{StaticResource CHB}">
        <Setter Property="Margin" Value="0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="#202936" />
      </Style>
      <Style TargetType="TextBox" BasedOn="{StaticResource KPLN_TextBox}">
        <Setter Property="Margin" Value="0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="#202936" />
        <Setter Property="Background" Value="White" />
        <Setter Property="CaretBrush" Value="#202936" />
      </Style>
      <Style TargetType="Button" BasedOn="{StaticResource BTN}">
        <Setter Property="Margin" Value="0" />
        <Setter Property="FontSize" Value="12" />
      </Style>
    </ResourceDictionary>
  </Window.Resources>
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="12" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="8" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock x:Name="StatusText" FontSize="14" Text="Подготовка..." />
    <ProgressBar x:Name="MainProgressBar" Grid.Row="2" Height="20" Minimum="0" Maximum="100" Value="0" />
    <TextBlock x:Name="PercentText" Grid.Row="4" HorizontalAlignment="Right" Text="0 / 0" />
  </Grid>
</Window>