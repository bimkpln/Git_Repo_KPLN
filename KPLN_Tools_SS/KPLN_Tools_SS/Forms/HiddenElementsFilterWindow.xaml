<Window x:Class="KPLN_Tools_SS.Forms.HiddenElementsFilterWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="KPLN. Управление скрытыми элементами" Height="590" Width="1040" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="False">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/KPLN_Library_Forms;component/UI/LibStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <Style TargetType="TextBlock" BasedOn="{StaticResource TXT}">
        <Setter Property="Margin" Value="0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="#202936" />
        <Setter Property="MaxWidth" Value="Infinity" />
      </Style>
      <Style TargetType="ComboBox" BasedOn="{StaticResource CBX}">
        <Setter Property="Margin" Value="0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="#202936" />
      </Style>
      <Style TargetType="RadioButton" BasedOn="{StaticResource RB}">
        <Setter Property="Margin" Value="0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="#202936" />
      </Style>
      <Style TargetType="CheckBox" BasedOn="{StaticResource CHB}">
        <Setter Property="Margin" Value="0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="#202936" />
      </Style>
      <Style TargetType="TextBox" BasedOn="{StaticResource KPLN_TextBox}">
        <Setter Property="Margin" Value="0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="#202936" />
        <Setter Property="Background" Value="White" />
        <Setter Property="CaretBrush" Value="#202936" />
      </Style>
      <Style TargetType="Button" BasedOn="{StaticResource BTN}">
        <Setter Property="Margin" Value="0" />
        <Setter Property="FontSize" Value="12" />
      </Style>
    </ResourceDictionary>
  </Window.Resources>
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <DataGrid x:Name="SheetsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Margin="0,0,0,12">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Лист" Binding="{Binding SheetDisplayName}" Width="*" />
        <DataGridTextColumn Header="Планов всего" Binding="{Binding PlansCount}" Width="110" />
        <DataGridTextColumn Header="Планов со скрытыми" Binding="{Binding PlansWithHiddenElementsCount}" Width="150" />
        <DataGridTextColumn Header="Скрытий" Binding="{Binding HiddenOccurrencesCount}" Width="110" />
        <DataGridTextColumn Header="Уникальных элементов" Binding="{Binding HiddenUniqueElementsCount}" Width="170" />
      </DataGrid.Columns>
    </DataGrid>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button x:Name="SaveReportButton" Content="Сохранить отчёт" Width="170" Height="30" Click="SaveReport_Click" />
      <CheckBox x:Name="UnhideAllElementsCheckBox" Grid.Column="2" VerticalAlignment="Center" Content="Сделать видимыми все скрытые элементы" IsChecked="False" />
      <Button Grid.Column="4" Content="Применить" Width="120" Height="30" Click="Apply_Click" />
      <Button Grid.Column="6" Content="Отмена" Width="100" Height="30" Click="Cancel_Click" />
    </Grid>
  </Grid>
</Window>