<Window x:Class="KPLN_Tools_SS.Forms.CabinetMismatchWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="KPLN. Результаты проверки" Height="500" Width="780" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Topmost="False">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/KPLN_Library_Forms;component/UI/LibStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <Style TargetType="TextBlock" BasedOn="{StaticResource TXT}">
        <Setter Property="Margin" Value="0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="#202936" />
        <Setter Property="MaxWidth" Value="Infinity" />
      </Style>
      <Style TargetType="ComboBox" BasedOn="{StaticResource CBX}">
        <Setter Property="Margin" Value="0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="#202936" />
      </Style>
      <Style TargetType="RadioButton" BasedOn="{StaticResource RB}">
        <Setter Property="Margin" Value="0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="#202936" />
      </Style>
      <Style TargetType="CheckBox" BasedOn="{StaticResource CHB}">
        <Setter Property="Margin" Value="0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="#202936" />
      </Style>
      <Style TargetType="TextBox" BasedOn="{StaticResource KPLN_TextBox}">
        <Setter Property="Margin" Value="0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="#202936" />
        <Setter Property="Background" Value="White" />
        <Setter Property="CaretBrush" Value="#202936" />
      </Style>
      <Style TargetType="Button" BasedOn="{StaticResource BTN}">
        <Setter Property="Margin" Value="0" />
        <Setter Property="FontSize" Value="12" />
      </Style>
    </ResourceDictionary>
  </Window.Resources>
  <DockPanel Margin="10">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <TextBlock TextWrapping="Wrap" FontWeight="Bold">Найдены несоответствия между параметром "Имя панели" и параметром "КП_О_Группирование".
            </TextBlock>
    </StackPanel>
    <Grid Grid.IsSharedSizeScope="True">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <!-- ШКАФЫ -->
      <GroupBox Header=" Электрооборудование, для которого у элементов узлов отсутствует соответствующее значение параметра ``КП_О_Группирование``" Grid.Row="0" Margin="0,0,0,5">
        <ListBox x:Name="ListBoxCabinets" HorizontalContentAlignment="Stretch">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" SharedSizeGroup="ButtonsColumn" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding DisplayName}" TextWrapping="Wrap" />
                <Button Grid.Column="1" Content="Перейти" Margin="8,0,0,0" Padding="10,2" HorizontalAlignment="Right" Click="GoTo_Click" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </GroupBox>
      <!-- ЭЛЕМЕНТЫ УЗЛОВ -->
      <GroupBox Header="Элементы узлов, для которых у электрооборудования отсутствует соответствующее значение параметра ``Имя панели``" Grid.Row="1">
        <ListBox x:Name="ListBoxNodes" HorizontalContentAlignment="Stretch">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" SharedSizeGroup="ButtonsColumn" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding DisplayName}" TextWrapping="Wrap" />
                <Button Grid.Column="1" Content="Перейти" Margin="8,0,0,0" Padding="10,2" HorizontalAlignment="Right" Click="GoTo_Click" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </GroupBox>
    </Grid>
  </DockPanel>
</Window>