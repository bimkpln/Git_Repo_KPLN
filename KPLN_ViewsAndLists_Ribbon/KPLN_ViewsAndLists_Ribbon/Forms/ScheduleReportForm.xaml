<Window x:Class="KPLN_ViewsAndLists_Ribbon.Forms.ScheduleReportForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KPLN: Итоги работы со спецификациями" Width="650" Height="570" MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterOwner" Background="#2B2F38" Foreground="#EDEDED" FontFamily="Segoe UI" FontSize="14">
    <Window.Resources><ResourceDictionary Source="ScheduleManagerStyles.xaml"/></Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Итоги выполнения" Style="{StaticResource FormText}" FontSize="24" FontWeight="SemiBold" Margin="6,0,6,12"/>
        <Border Grid.Row="1" Style="{StaticResource KPLN_CardBorder}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock Text="{Binding Text}" Style="{StaticResource FormText}" TextWrapping="Wrap"/>
            </ScrollViewer>
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Копировать отчёт" Click="CopyReport"/>
            <Button Content="Закрыть" IsCancel="True" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
