<Window x:Class="KPLN_ViewsAndLists_Ribbon.Forms.ScheduleFiltersForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:KPLN_ViewsAndLists_Ribbon.Forms"
        xmlns:models="clr-namespace:KPLN_ViewsAndLists_Ribbon.Common.Schedules"
        Title="KPLN: Управление фильтрами — листы по этажам" Width="1440" Height="850" MinWidth="1100" MinHeight="650"
        WindowStartupLocation="CenterOwner" Background="#2B2F38" Foreground="#EDEDED" FontFamily="Segoe UI" FontSize="14">
    <Window.Resources><ResourceDictionary Source="ScheduleManagerStyles.xaml"/></Window.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="2*" MinHeight="140"/><RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="3*" MinHeight="130"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Style="{StaticResource FormText}" Text="{Binding ScheduleName}" FontSize="19" FontWeight="SemiBold" Margin="6" TextWrapping="Wrap"/>
        <TextBlock Grid.Row="1" Style="{StaticResource Hint}" Text="Синие строки — существующие фильтры, зелёные — новые, красные — помеченные к удалению. Добавляйте условия и выбирайте параметры как в конструкторе спецификаций. Недостающее поле добавится скрытым. Итоговые значения по выбранным уровням показаны ниже."/>
        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <Button Content="Добавить правило" Click="AddRule"/>
            <Button Content="Удалить / восстановить" Click="RemoveRule" ToolTip="Существующее условие помечается к удалению; повторное нажатие восстановит его. Новая строка удаляется из списка."/>
        </StackPanel>
        <DataGrid x:Name="RulesGrid" Grid.Row="3" ItemsSource="{Binding Rules}" CanUserDeleteRows="False">
            <DataGrid.RowStyle><Style TargetType="DataGridRow">
                <Setter Property="Background" Value="#E4F3E5"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsExisting}" Value="True"><Setter Property="Background" Value="#DCEBFA"/></DataTrigger>
                    <DataTrigger Binding="{Binding Deleted}" Value="True"><Setter Property="Background" Value="#F6DDDD"/></DataTrigger>
                    <DataTrigger Binding="{Binding Enabled}" Value="False"><Setter Property="Opacity" Value="0.6"/></DataTrigger>
                </Style.Triggers>
            </Style></DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="✓" Width="40"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                    <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" ToolTip="Снятый флажок отключает изменение: исходный фильтр сохраняется, новый не добавляется."/>
                </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTextColumn Header="Состояние" Binding="{Binding State}" Width="120" IsReadOnly="True" ElementStyle="{StaticResource DG_TC}"/>
                <DataGridTemplateColumn Header="Параметр" Width="2*" MinWidth="210"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                    <ContentControl Content="{Binding}"><ContentControl.Style><Style TargetType="ContentControl">
                        <Setter Property="ContentTemplate"><Setter.Value><DataTemplate>
                            <TextBlock Text="{Binding Parameter.Name}" ToolTip="{Binding Parameter.Label}" Style="{StaticResource DG_TC}"/>
                        </DataTemplate></Setter.Value></Setter>
                        <Style.Triggers><DataTrigger Binding="{Binding CanChangeParameter}" Value="True">
                            <Setter Property="ContentTemplate"><Setter.Value><DataTemplate>
                                <local:ScheduleParameterComboBox Style="{StaticResource {x:Type ComboBox}}" IsEnabled="{Binding CanEdit}"
                                    ItemsSource="{Binding DataContext.Parameters, RelativeSource={RelativeSource AncestorType=Window}}"
                                    SelectedItem="{Binding Parameter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="Name"/>
                            </DataTemplate></Setter.Value></Setter>
                        </DataTrigger></Style.Triggers>
                    </Style></ContentControl.Style></ContentControl>
                </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Условие" Width="190"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                    <ComboBox IsEnabled="{Binding CanEdit}" ItemsSource="{x:Static models:BatchScheduleFilter.Conditions}" SelectedItem="{Binding Condition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTextColumn Header="Исходное значение" Binding="{Binding OriginalValue}" IsReadOnly="True" Width="140" ElementStyle="{StaticResource DG_TC}"/>
                <DataGridTextColumn Header="Тип (авто)" Binding="{Binding Kind, Mode=OneWay}" IsReadOnly="True" Width="135" ElementStyle="{StaticResource DG_TC}"/>
                <DataGridTemplateColumn Header="Значение по этажам" Width="175"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                    <ComboBox IsEnabled="{Binding CanEdit}" ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Значение или маска" Width="*" MinWidth="190"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                    <DockPanel IsEnabled="{Binding CanEditPattern}">
                        <Button DockPanel.Dock="Right" Content="…" Click="EditMask" ToolTip="Маски для листов по этажам" Padding="8,2"/>
                        <TextBox Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="Обычное значение или маска. Числа — в единицах проекта, ссылки — ID или уникальное имя элемента."/>
                    </DockPanel>
                </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <Border Grid.Row="4" Height="1" VerticalAlignment="Center" Background="#46505F"/>
        <DockPanel Grid.Row="5">
            <Button DockPanel.Dock="Right" Content="Пересчитать по этажам" Click="RebuildValues" ToolTip="Сбросить ручные поправки к маскам и заново вычислить значения. Режим «Вручную по этажам» сохраняет введённые значения."/>
            <TextBlock Style="{StaticResource Hint}" Text="Результат обновляется при изменении правил. «Сохранить» оставляет исходное значение; «Целевой уровень» подставляет уровень Revit. Для ручного режима редактируйте нижнюю таблицу. Маски: {Этаж}, {Уровень}, {Отметка}, {Типовые}, {Индекс}; {Исходное} — только для существующих фильтров."/>
        </DockPanel>
        <DataGrid x:Name="ValuesGrid" Grid.Row="6" ItemsSource="{Binding Values}" BeginningEdit="BeginValueEdit" CanUserDeleteRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Уровень" Binding="{Binding LevelName}" IsReadOnly="True" Width="300" ElementStyle="{StaticResource DG_TC}"/>
                <DataGridTextColumn Header="Параметр / условие" Binding="{Binding Field}" IsReadOnly="True" Width="*" MinWidth="260" ElementStyle="{StaticResource DG_TC}"/>
                <DataGridTextColumn Header="Действие" Binding="{Binding Mode}" IsReadOnly="True" Width="180" ElementStyle="{StaticResource DG_TC}"/>
                <DataGridTextColumn Header="Значение для этажа" Binding="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="*" MinWidth="200"
                    ElementStyle="{StaticResource DG_TC}" EditingElementStyle="{StaticResource KPLN_TextBox}"/>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock x:Name="PreviewStatus" Grid.Row="7" Style="{StaticResource Hint}"/>
        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Применить настройки" Click="Apply"/>
            <Button Content="Отмена" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
