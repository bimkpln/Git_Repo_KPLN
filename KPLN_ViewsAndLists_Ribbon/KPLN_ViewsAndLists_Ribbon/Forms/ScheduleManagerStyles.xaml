<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/KPLN_Library_Forms;component/UI/LibStyles.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <Style TargetType="Button" BasedOn="{StaticResource KPLN_Button}">
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="12,5" />
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource KPLN_TextBox}" />
    <Style TargetType="CheckBox" BasedOn="{StaticResource KPLN_CheckBox}" />
    <Style TargetType="ComboBox" BasedOn="{StaticResource CBX}" />
    <!-- В LibStyles нет стилей таблиц и вкладок; здесь остаются настройки этих элементов. -->
    <Style TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="Foreground" Value="#20262F" />
        <Setter Property="Background" Value="White" />
        <Setter Property="RowBackground" Value="White" />
        <Setter Property="AlternatingRowBackground" Value="#EDF1F7" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="#DCE2EB" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="MinRowHeight" Value="32" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Margin" Value="4" />
        <Setter Property="EnableRowVirtualization" Value="True" />
    </Style>
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#DCE5F2" />
        <Setter Property="Foreground" Value="#20262F" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="#EDEDED" />
        <Setter Property="Padding" Value="15,8" />
        <Setter Property="HeaderTemplate">
            <Setter.Value><DataTemplate><TextBlock Text="{Binding}" Foreground="#20262F" /></DataTemplate></Setter.Value>
        </Setter>
    </Style>
    <!-- Размеры текста адаптированы к плотной форме; оформление наследуется из библиотеки. -->
    <Style x:Key="FormText" TargetType="TextBlock" BasedOn="{StaticResource KPLN_TextBlock}">
        <Setter Property="MaxWidth" Value="Infinity" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="FontSize" Value="14" />
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource FormText}">
        <Setter Property="Margin" Value="6" />
    </Style>
</ResourceDictionary>
