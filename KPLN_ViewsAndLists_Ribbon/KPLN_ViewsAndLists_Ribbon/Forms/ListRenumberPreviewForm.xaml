<Window x:Class="KPLN_ViewsAndLists_Ribbon.Forms.ListRenumberPreviewForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KPLN: Предпросмотр нумерации листов"
        Width="1280" Height="640" MinWidth="800" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#2B2F38" Foreground="#EDEDED"
        FontFamily="Segoe UI" ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/KPLN_Library_Forms;component/UI/LibStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="PreviewCellText" TargetType="TextBlock">
                <Setter Property="Margin" Value="6,4" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="PreviewUnicodeText" TargetType="TextBlock" BasedOn="{StaticResource PreviewCellText}">
                <Setter Property="Foreground" Value="#F4C779" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Style.Triggers>
                    <Trigger Property="Text" Value="—">
                        <Setter Property="Foreground" Value="#919AAA" />
                        <Setter Property="FontWeight" Value="Normal" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="PreviewCellEditor" TargetType="TextBox">
                <Setter Property="Padding" Value="4,2" />
                <Setter Property="Foreground" Value="#171B23" />
                <Setter Property="Background" Value="White" />
            </Style>
            <Style TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="#333840" />
                <Setter Property="Foreground" Value="#EDEDED" />
                <Setter Property="Padding" Value="8,10" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="BorderBrush" Value="#555B66" />
                <Setter Property="BorderThickness" Value="0,0,1,1" />
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="DataGridCell">
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="#EDEDED" />
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="#315984" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="Проверьте и при необходимости исправьте нумерацию" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Help}" Margin="0,8,0,0" TextWrapping="Wrap" />
            <TextBlock Text="До нажатия «Применить» изменения остаются только в этой таблице."
                       Foreground="#BAC2D0" Margin="0,4,0,0" />
        </StackPanel>
        <DataGrid IsEnabled="{Binding CanEdit}" x:Name="PreviewGrid" Grid.Row="1" ItemsSource="{Binding Rows}"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  CanUserReorderColumns="False" EnableRowVirtualization="True"
                  HeadersVisibility="Column" SelectionUnit="Cell" SelectionMode="Single"
                  Background="#2B2F38" RowBackground="#333840" AlternatingRowBackground="#383E48"
                  Foreground="#EDEDED" BorderBrush="#555B66" GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#4B515D" RowHeaderWidth="0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название листа" Binding="{Binding SheetName}" IsReadOnly="True" Width="2*" MinWidth="180"
                                    ElementStyle="{StaticResource PreviewCellText}" />
                <DataGridTextColumn Header="Текущий номер" Binding="{Binding OriginalNumberText}" IsReadOnly="True" Width="140"
                                    ElementStyle="{StaticResource PreviewCellText}" />
                <DataGridTextColumn Header="Приставки текущего" Binding="{Binding OriginalPrefix}" IsReadOnly="True" Width="105"
                                    ElementStyle="{StaticResource PreviewCellText}" />
                <DataGridTextColumn Header="Unicode текущего" Binding="{Binding OriginalUnicode}" IsReadOnly="True" Width="130">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource PreviewUnicodeText}">
                            <Setter Property="ToolTip" Value="{Binding OriginalUnicodeDetails}" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn x:Name="NumberColumn" Header="Новый номер" Width="160"
                                    Binding="{Binding EditableNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    ElementStyle="{StaticResource PreviewCellText}" EditingElementStyle="{StaticResource PreviewCellEditor}" />
                <DataGridTextColumn Header="Приставки нового" Binding="{Binding NewPrefix}" IsReadOnly="True" Width="105"
                                    ElementStyle="{StaticResource PreviewCellText}" />
                <DataGridTextColumn Header="Unicode нового" Binding="{Binding NewUnicode}" IsReadOnly="True" Width="130">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource PreviewUnicodeText}">
                            <Setter Property="ToolTip" Value="{Binding NewUnicodeDetails}" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn x:Name="OldParameterColumn" Header="Текущее значение параметра" Width="150" IsReadOnly="True"
                                    Binding="{Binding OriginalParameterValue}" ElementStyle="{StaticResource PreviewCellText}" />
                <DataGridTextColumn x:Name="ParameterColumn" Header="Новое значение параметра" Width="160"
                                    Binding="{Binding NewParameterValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    ElementStyle="{StaticResource PreviewCellText}" EditingElementStyle="{StaticResource PreviewCellEditor}" />
                <DataGridTextColumn Header="Проверка" Binding="{Binding Error}" IsReadOnly="True" Width="1.5*" MinWidth="160">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource PreviewCellText}">
                            <Setter Property="Foreground" Value="#FFC29F" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock Grid.Row="2" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,12,0,12" />
        <DockPanel Grid.Row="3" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="Продолжить нумерацию вниз" Width="260" Margin="0"
                    IsEnabled="{Binding CanContinueNumbering}" Click="ContinueNumbering_Click"
                    ToolTip="Выберите ячейку «Новый номер». Строки ниже получат номера с шагом +1 в текущем порядке таблицы. Приставки, Unicode, ведущие нули и подномера сохранятся."
                    Style="{StaticResource KPLN_Button}" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button Content="Назад" IsCancel="True" Click="Back_Click" Width="110" Margin="0,0,10,0" Style="{StaticResource KPLN_Button}" />
            <Button Content="Применить" IsEnabled="{Binding CanApply}" Width="130" Click="Apply_Click" Style="{StaticResource KPLN_RunButton}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
