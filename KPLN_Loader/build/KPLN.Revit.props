<Project>
  <!-- Свойства определяются ДО SDK/NuGet imports, в том числе при оценке проекта студией. -->
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == '' OR '$(Configuration)' == 'Debug'">Debug2020</Configuration>
    <Platform Condition="'$(Platform)' == '' OR '$(Platform)' == 'AnyCPU'">x64</Platform>
    <Configurations>Debug2020;Revit2020;Revit2020_ExtraNet;Debug2023;Revit2023;Debug2023_ExtraNet;Revit2023_ExtraNet;Debug2024;Revit2024;Debug2024_ExtraNet;Revit2024_ExtraNet;Debug2026;Revit2026;Debug2026_ExtraNet;Revit2026_ExtraNet</Configurations>
    <Platforms>x64</Platforms>
    <RevitVer>$([System.Text.RegularExpressions.Regex]::Match('$(Configuration)', '20[0-9]{2}').Value)</RevitVer>
    <TargetFramework Condition="'$(RevitVer)' != '2026'">net48</TargetFramework>
    <TargetFramework Condition="'$(RevitVer)' == '2026'">net8.0-windows7.0</TargetFramework>
    <RestoreProjectStyle>PackageReference</RestoreProjectStyle>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
    <!-- Каждая платформа восстанавливается независимо; конфигурации одного .NET используют общий кэш. -->
    <MSBuildProjectExtensionsPath>$(MSBuildProjectDirectory)\obj\NuGet\$(TargetFramework)\</MSBuildProjectExtensionsPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableDefaultItems>false</EnableDefaultItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>7.3</LangVersion>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
