<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/KPLN_Library_Forms;component/UI/LibStyles.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style TargetType="{x:Type ToolTip}" BasedOn="{StaticResource KPLN_TextToolTip}" />

    <!-- В окнах остаются только размеры; базовое оформление берём из Forms. -->
    <Style x:Key="ConfigHeading" TargetType="TextBlock" BasedOn="{StaticResource KPLN_TextBlock}">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MaxWidth" Value="494" />
        <Setter Property="Margin" Value="0" />
    </Style>

    <Style x:Key="ConfigLabel" TargetType="TextBlock" BasedOn="{StaticResource KPLN_TextBlock}">
        <Setter Property="MaxWidth" Value="494" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="ModernTextBox" TargetType="TextBox" BasedOn="{StaticResource KPLN_TextBox}">
        <Setter Property="ToolTipService.ShowDuration" Value="30000" />
        <Setter Property="Height" Value="42" />
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="Margin" Value="0" />
    </Style>

    <Style x:Key="PillButton" TargetType="ToggleButton" BasedOn="{StaticResource KPLN_ToggleButton}">
        <Setter Property="ToolTipService.ShowDuration" Value="30000" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        <Setter Property="Height" Value="44" />
        <Setter Property="MinWidth" Value="120" />
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource KPLN_Button}">
        <Setter Property="ToolTipService.ShowDuration" Value="30000" />
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Background" Value="#2563EB" />
        <Setter Property="Margin" Value="5" />
        <Setter Property="Padding" Value="12,8" />
    </Style>
</ResourceDictionary>
