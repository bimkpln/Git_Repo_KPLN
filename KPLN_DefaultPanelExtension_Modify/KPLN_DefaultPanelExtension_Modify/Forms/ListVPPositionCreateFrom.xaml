<Window x:Class="KPLN_DefaultPanelExtension_Modify.Forms.ListVPPositionCreateFrom"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:local="clr-namespace:KPLN_DefaultPanelExtension_Modify.Forms"
        xmlns:vconv="clr-namespace:KPLN_DefaultPanelExtension_Modify.Forms.ValueConvertors"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Title="KPLN: Создание конфигурации"
        Background="#2B2F38"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Loaded="OnLoaded">


    <Window.InputBindings>
        <KeyBinding
    Key="Escape"
    Command="{Binding CloseWindowCmd}"
    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />
    </Window.InputBindings>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ListVPPositionCreateStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Радио-группа для ToggleButton -->
            <vconv:EnumEqualsConverter x:Key="EnumEqualsConverter"/>
        </ResourceDictionary>
    </Window.Resources>


    <Grid>
        <!-- Центровка карточки -->
        <Border Width="550"
            Padding="28"
            Margin="0"
            Style="{StaticResource KPLN_CardBorder}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Заголовок -->
                <StackPanel Grid.Row="0" Margin="0,0,0,18">
                    <TextBlock Text="Создание конфигурации"
                        Style="{StaticResource ConfigHeading}"/>
                </StackPanel>

                <!-- Имя -->
                <StackPanel Grid.Row="1" Margin="0,0,0,18">
                    <TextBlock Text="Введи имя конфигурации"
                        Style="{StaticResource ConfigLabel}"
                        Margin="0,0,0,8"/>
                    <TextBox 
                    x:Name="ConfigName"
                    Style="{StaticResource ModernTextBox}"
                    ToolTip="Введи понятное имя для сохранённого положения выбранного вида на листе-доноре. Формат листа для штампов КПЛН, способ выравнивания и тип вида добавятся автоматически в техническую часть: [А2х1_Ц_ПП]: Типовой план."
                    Text="{Binding ListVPPositionItem.ConfigName, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <!-- Условие -->
                <StackPanel Grid.Row="2" Margin="0,0,0,10">
                    <TextBlock Text="Выбери условие выравнивания"
                        Style="{StaticResource ConfigLabel}"
                        ToolTip="Углы и центр используют границы вида на листе, которые Revit рассчитывает с учётом подрезки. СВН использует координаты модели. Для одинакового положения по границам подготовь одинаковую подрезку; её можно перенести плагином «Виды и листы. Копировать подрезку»."
                        ToolTipService.ShowDuration="30000"
                        Margin="0,0,0,12"/>
                </StackPanel>

                <!-- Кнопки-раскладка 3x3 (с пустыми ячейками как на примере) -->
                <Grid Grid.Row="3" Margin="0,0,0,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Лево верх -->
                    <ToggleButton Grid.Row="0" Grid.Column="0"
                            Style="{StaticResource PillButton}"
                            Content="Лево  верх"
                            ToolTip="ЛВ — сохранить положение верхнего левого угла границ вида на листе. При применении этот угол другого вида совместится с сохранённой точкой. Результат зависит от подрезки, но не от координат модели: подходит для разных секций, размещаемых в одном месте листа."
                            IsChecked="{Binding ListVPPositionItem.SelectedAlign, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=LeftTop}"
                            Command="{Binding SelectAlignCmd}"
                            CommandParameter="LeftTop"/>

                    <!-- Право верх -->
                    <ToggleButton Grid.Row="0" Grid.Column="2"
                            Style="{StaticResource PillButton}"
                            Content="Право  верх"
                            ToolTip="ПВ — сохранить положение верхнего правого угла границ вида на листе. При применении этот угол другого вида совместится с сохранённой точкой. Результат зависит от подрезки, но не от координат модели: подходит для разных секций, размещаемых в одном месте листа."
                            IsChecked="{Binding ListVPPositionItem.SelectedAlign, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=RightTop}"
                            Command="{Binding SelectAlignCmd}"
                            CommandParameter="RightTop"/>

                    <!-- Центр -->
                    <ToggleButton Grid.Row="1" Grid.Column="1"
                            Style="{StaticResource PillButton}"
                            Content="Центр"
                            ToolTip="Ц — сохранить положение центра границ вида на листе. При применении центры совместятся. Изменение подрезки меняет границы и их центр, поэтому элементы модели могут оказаться в другом месте относительно листа. Для привязки по координатам модели используй СВН."
                            MinWidth="140"
                            IsChecked="{Binding ListVPPositionItem.SelectedAlign, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Center}"
                            Command="{Binding SelectAlignCmd}"
                            CommandParameter="Center"/>

                    <!-- Лево низ -->
                    <ToggleButton Grid.Row="2" Grid.Column="0"
                            Style="{StaticResource PillButton}"
                            Content="Лево  низ"
                            ToolTip="ЛН — сохранить положение нижнего левого угла границ вида на листе. При применении этот угол другого вида совместится с сохранённой точкой. Результат зависит от подрезки, но не от координат модели: подходит для разных секций, размещаемых в одном месте листа."
                            IsChecked="{Binding ListVPPositionItem.SelectedAlign, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=LeftBottom}"
                            Command="{Binding SelectAlignCmd}"
                            CommandParameter="LeftBottom"/>

                    <!-- Право низ -->
                    <ToggleButton Grid.Row="2" Grid.Column="2"
                            Style="{StaticResource PillButton}"
                            Content="Право  низ"
                            ToolTip="ПН — сохранить положение нижнего правого угла границ вида на листе. При применении этот угол другого вида совместится с сохранённой точкой. Результат зависит от подрезки, но не от координат модели: подходит для разных секций, размещаемых в одном месте листа."
                            IsChecked="{Binding ListVPPositionItem.SelectedAlign, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=RightBottom}"
                            Command="{Binding SelectAlignCmd}"
                            CommandParameter="RightBottom"/>
                    
                    <!-- Право низ -->
                    <ToggleButton Grid.Row="3" Grid.ColumnSpan="3"
                            Style="{StaticResource PillButton}"
                            Content="Совмещение внутренних начал"
                            ToolTip="СВН — выравнивать по внутреннему началу модели, независимо от границ подрезки. Подходит для видов с одинаковыми координатами модели, например этажей односекционного здания. Для разных по координатам секций используй углы или центр. Для видов без связи с координатами модели, включая спецификации и легенды, этот режим недоступен."
                            IsChecked="{Binding ListVPPositionItem.SelectedAlign, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=OrignToOrigin}"
                            IsEnabled="{Binding ListVPPositionItem.ByOriginVisible}"
                            Command="{Binding SelectAlignCmd}"
                            CommandParameter="OrignToOrigin"/>
                </Grid>

                <!-- Сохранить/подсказка -->
                <DockPanel Grid.Row="4"
                        LastChildFill="False">
                    <Button 
                        Style="{StaticResource PrimaryButton}"
                        Content="Сохранить"
                        ToolTip="Записать конфигурацию положения выбранного вида на листе-доноре. Затем выбери вид на другом листе и нажми сохранённую конфигурацию в основном окне, чтобы применить это положение."
                        Width="400"
                        Command="{Binding SaveCmd}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
                    <Button 
                        Style="{StaticResource PrimaryButton}"
                        Content="?"
                        ToolTip="Открыть главу «Плагин Положение вида» в инструкции на Moodle: создание конфигурации, примеры выравнивания по углам, центру и внутреннему началу, рекомендации по выбору режима."
                        Width="60"
                        Command="{Binding HelpCmd}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
