<Window x:Class="KPLN_Tools.Forms.AR_CalculateTEP"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Расчёт ТЭП" Width="1220" Height="860" MinWidth="980" MinHeight="650"
        WindowStartupLocation="CenterOwner" Background="#F2F5F9" Foreground="#24354B"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="#627188"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="LineHeight" Value="18"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#F5F7FA"/>
            <Setter Property="BorderBrush" Value="#C7D1DF"/>
            <Setter Property="Foreground" Value="#24354B"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#D9E9FA"/>
            <Setter Property="BorderBrush" Value="#96BBDD"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="MaxDropDownHeight" Value="320"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#C7D1DF"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border Background="White" BorderBrush="#DCE3ED" BorderThickness="1" CornerRadius="7" Padding="16">
                            <DockPanel LastChildFill="True">
                                <TextBlock DockPanel.Dock="Top" Text="{TemplateBinding Header}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,14" TextWrapping="Wrap"/>
                                <ContentPresenter/>
                            </DockPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="16,10"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="5" BorderThickness="1" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#EDF3FA"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#E5EFFB"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#B4CEE8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ReportText" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="Расчёт ТЭП" FontSize="25" FontWeight="SemiBold"/>
            <TextBlock Style="{StaticResource Hint}" Text="Настройте состав расчёта, проверьте площади по этажам и постройте контуры." Margin="0,5,0,0"/>
        </StackPanel>
        <TabControl x:Name="Tabs" Grid.Row="1" Background="#F7F9FC" BorderBrush="#DCE3ED" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
            <TabItem Header="1. Методика и модель">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="16">
                        <GroupBox Header="Методика расчёта">
                            <StackPanel>
                                <ComboBox x:Name="MethodBox" Width="240" HorizontalAlignment="Left" SelectionChanged="MethodChanged"/>
                                <Expander Header="Отличия старой и новой методики" IsExpanded="False">
                                    <Border Background="#F0F5FB" CornerRadius="5" Padding="12" Margin="0,10,0,0">
                                        <TextBlock x:Name="MethodHelp" Style="{StaticResource Hint}"/>
                                    </Border>
                                </Expander>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Корпуса и границы расчёта">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="Способ идентификации корпуса"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource FieldLabel}" Text="Отметка земли, м · справочно"/>
                                <ComboBox Grid.Row="1" x:Name="GroupingBox" SelectedItem="{Binding Grouping, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBox Grid.Row="1" Grid.Column="2" x:Name="GroundBox" Text="{Binding Ground, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="Параметр корпуса"/>
                                <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource FieldLabel}" Text="Источник отметки земли"/>
                                <ComboBox Grid.Row="3" x:Name="BuildingBox" IsEditable="True" Text="{Binding BuildingParameter, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Grid.Row="3" Grid.Column="2" Content="Прочитать выбранную поверхность" Click="ReadGround" VerticalAlignment="Top" ToolTip="Топография или топотело, выбранные до запуска"/>
                                <TextBlock Grid.Row="4" Style="{StaticResource FieldLabel}" Text="Имя корпуса при ручном выборе"/>
                                <TextBox Grid.Row="5" Text="{Binding ManualBuilding, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Grid.Row="4" Grid.RowSpan="2" Grid.Column="2" Style="{StaticResource Hint}" Text="Первый наземный уровень задаётся отдельно для каждого показателя. Для цоколя проверьте превышение верха перекрытия над средней планировочной отметкой земли не менее чем на 2 м."/>
                                <StackPanel Grid.Row="6" Grid.ColumnSpan="3">
                                    <CheckBox IsChecked="{Binding SelectedOnly}">
                                        <TextBlock Text="Только элементы и экземпляры связей, выбранные до запуска" TextWrapping="Wrap"/>
                                    </CheckBox>
                                    <TextBlock Style="{StaticResource Hint}" Text="Для ручного выбора выделите элементы корпуса или экземпляр связи перед запуском. Выбранная связь включает все её элементы."/>
                                </StackPanel>
                            </Grid>
                        </GroupBox>
                        <GroupBox Header="Источники модели">
                            <StackPanel>
                                <DataGrid x:Name="SourceGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" MinHeight="100" MaxHeight="240" HeadersVisibility="Column" RowHeaderWidth="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E8EDF4" BorderBrush="#DCE3ED" RowHeight="42" ColumnHeaderHeight="32" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Модель / экземпляр связи" Binding="{Binding Name}" IsReadOnly="True" Width="*" MinWidth="200">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                    <Setter Property="TextWrapping" Value="NoWrap"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="Margin" Value="8,0"/>
                                                    <Setter Property="ToolTip" Value="{Binding Name}"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridCheckBoxColumn Header="Загружен" Binding="{Binding Loaded, Mode=OneWay}" IsReadOnly="True" Width="85">
                                            <DataGridCheckBoxColumn.ElementStyle>
                                                <Style TargetType="CheckBox">
                                                    <Setter Property="Margin" Value="0"/>
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="IsHitTestVisible" Value="False"/>
                                                    <Setter Property="Focusable" Value="False"/>
                                                </Style>
                                            </DataGridCheckBoxColumn.ElementStyle>
                                        </DataGridCheckBoxColumn>
                                        <DataGridTemplateColumn Header="Участие" Width="180">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox SelectedValuePath="Content" SelectedValue="{Binding Mode, UpdateSourceTrigger=PropertyChanged}" Margin="4" Height="32">
                                                        <ComboBoxItem Content="Включать"/>
                                                        <ComboBoxItem Content="Исключить"/>
                                                        <ComboBoxItem Content="Только проверка"/>
                                                    </ComboBox>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="2. Показатели и правила">
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="270"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Показатели" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <Grid Grid.Row="1" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Button Content="Выбрать все" Click="SelectAll"/>
                            <Button Grid.Column="2" Content="Снять все" Click="SelectNone"/>
                        </Grid>
                        <ListBox Grid.Row="2" x:Name="MetricList" SelectionChanged="MetricChanged" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding Enabled}" Margin="0,2,0,0" VerticalAlignment="Top"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" TextWrapping="Wrap"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="Editor" Margin="0,0,12,0">
                            <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,16"/>
                            <GroupBox Header="Исходные данные и этажи">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Основной источник"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource FieldLabel}" Text="Стадия"/>
                                    <ComboBox Grid.Row="1" x:Name="PrimaryBox" SelectedItem="{Binding Primary, UpdateSourceTrigger=PropertyChanged}"/>
                                    <ComboBox Grid.Row="1" Grid.Column="2" x:Name="PhaseBox" SelectedItem="{Binding Phase, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="Схема зон · для источника «Зоны»"/>
                                    <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource FieldLabel}" Text="Первый учитываемый уровень"/>
                                    <ComboBox Grid.Row="3" x:Name="SchemeBox" SelectedItem="{Binding AreaScheme, UpdateSourceTrigger=PropertyChanged}"/>
                                    <ComboBox Grid.Row="3" Grid.Column="2" x:Name="LevelBox" DisplayMemberPath="Name" SelectedValuePath="Key" SelectedValue="{Binding LevelKey, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding SelectedItem.Name, RelativeSource={RelativeSource Self}}"/>
                                    <CheckBox Grid.Row="4" Grid.ColumnSpan="3" IsChecked="{Binding AboveOnly}" Margin="0">
                                        <TextBlock Text="Учитывать только выбранный уровень и этажи выше" TextWrapping="Wrap"/>
                                    </CheckBox>
                                </Grid>
                            </GroupBox>
                            <GroupBox Header="Правила распознавания">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Hint}" Text="Категория и условие внутри тега работают вместе. Исключения имеют приоритет. Параметр читается у экземпляра, затем у типа." Margin="0,0,0,12"/>
                                    <CheckBox IsChecked="{Binding AllIncludes}">
                                        <TextBlock Text="Должны совпасть все теги «Включить» (иначе - любой)" TextWrapping="Wrap"/>
                                    </CheckBox>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Назначение правила"/>
                                        <TextBlock Grid.Column="2" Style="{StaticResource FieldLabel}" Text="Категория элемента · необязательно"/>
                                        <ComboBox Grid.Row="1" x:Name="RoleBox"/>
                                        <ComboBox Grid.Row="1" Grid.Column="2" x:Name="CategoryBox" IsEditable="True"/>
                                        <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="Имя параметра"/>
                                        <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource FieldLabel}" Text="Условие"/>
                                        <ComboBox Grid.Row="3" x:Name="ParameterBox" IsEditable="True"/>
                                        <ComboBox Grid.Row="3" Grid.Column="2" x:Name="OperationBox"/>
                                    </Grid>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Значение параметра"/>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="140"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="ValueBox" IsEditable="True" Margin="0"/>
                                        <Button Grid.Column="2" Content="Найти значения" Click="FindValues"/>
                                    </Grid>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Коэффициент летнего помещения"/>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="160"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="FactorBox" Text="0,5" Margin="0"/>
                                        <Button Grid.Column="3" Content="Добавить правило" Click="AddRule" Style="{StaticResource PrimaryButton}"/>
                                    </Grid>
                                    <TextBlock Style="{StaticResource Hint}" Text="Для разных коэффициентов создавайте отдельные теги: например, лоджии - 0,5; балконы и террасы - 0,3. Французские балконы задайте отдельным правилом."/>
                                    <ItemsControl ItemsSource="{Binding Rules}" Margin="0,14,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#EDF3FA" BorderBrush="#D5E2F0" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition/>
                                                            <ColumnDefinition Width="10"/>
                                                            <ColumnDefinition Width="28"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Label}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                        <Button Grid.Column="2" Content="×" ToolTip="Удалить правило" Click="RemoveRule" Height="28" Padding="0" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Content="Проверить параметры и совпадения" Click="CheckRules" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="Квартиры и вертикальные пространства">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Параметр номера / ID квартиры"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource FieldLabel}" Text="Параметр ID шахты / проёма"/>
                                    <ComboBox Grid.Row="1" x:Name="ApartmentBox" IsEditable="True" Text="{Binding ApartmentParameter, UpdateSourceTrigger=PropertyChanged}"/>
                                    <ComboBox Grid.Row="1" Grid.Column="2" x:Name="VoidBox" IsEditable="True" Text="{Binding VoidParameter, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="Параметр секции · необязательно"/>
                                    <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource FieldLabel}" Text="Параметр коэффициента · вместо тега"/>
                                    <ComboBox Grid.Row="3" x:Name="SectionBox" IsEditable="True" Text="{Binding SectionParameter, UpdateSourceTrigger=PropertyChanged}"/>
                                    <ComboBox Grid.Row="3" Grid.Column="2" x:Name="CoefficientBox" IsEditable="True" Text="{Binding FactorParameter, UpdateSourceTrigger=PropertyChanged}"/>
                                    <CheckBox Grid.Row="4" Grid.ColumnSpan="3" IsChecked="{Binding CountInstances}">
                                        <TextBlock Text="Количество квартир считать по экземплярам семейств" TextWrapping="Wrap"/>
                                    </CheckBox>
                                    <TextBlock Grid.Row="5" Grid.ColumnSpan="3" Style="{StaticResource Hint}" Text="Для шахт и проёмов используйте один ID на разных этажах. Нужны контуры каждого затронутого этажа. Лестничный просвет классифицируйте после проверки ширины. В ГНС коэффициент равен 1."/>
                                </Grid>
                            </GroupBox>
                            <GroupBox Header="Копирование настроек">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Взять настройки из показателя"/>
                                    <ComboBox x:Name="CopySourceBox" DisplayMemberPath="Title" ToolTip="{Binding SelectedItem.Title, RelativeSource={RelativeSource Self}}"/>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <Button Content="Скопировать в текущий" Click="CopySettings"/>
                                        <Button Grid.Column="2" Content="Текущие - всем" Click="ApplyToAll"/>
                                    </Grid>
                                    <TextBlock Style="{StaticResource Hint}" Text="Копируются правила, этажи, стадия и параметры в выбранной методике. Отметки расчёта сохраняются. Затем уточните различия жилой и нежилой частей."/>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <TabItem Header="3. Результаты">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource Hint}" Text="Сводка показывает площадь каждого этажа и итоги по корпусам. Площади - м², количество квартир - шт." Margin="0,0,0,12"/>
                    <TabControl x:Name="ReportTabs" Grid.Row="1" BorderBrush="#DCE3ED">
                        <TabItem Header="Площади по этажам">
                            <TextBox x:Name="ReportBox" Style="{StaticResource ReportText}"/>
                        </TabItem>
                        <TabItem Header="Подробности и ошибки">
                            <TextBox x:Name="DetailsBox" Style="{StaticResource ReportText}"/>
                        </TabItem>
                    </TabControl>
                </Grid>
            </TabItem>
        </TabControl>
        <Border Grid.Row="2" Padding="0,12,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="StatusText" Style="{StaticResource Hint}" MaxHeight="40" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Margin="0,0,0,10" Text="Выберите методику и настройте показатели."/>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="255"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="85"/>
                    </Grid.ColumnDefinitions>
                    <Button Content="Сохранить в модели" Click="SaveSettings">
                        <Button.ToolTip>
                            <TextBlock Width="340" TextWrapping="Wrap" Text="Сохраняет настройки показателей обеих методик и участие источников внутри текущей модели Revit. Отдельный файл не создаётся. После нажатия сохраните RVT (Ctrl+S). При следующем запуске плагина в этой модели настройки загрузятся автоматически."/>
                        </Button.ToolTip>
                    </Button>
                    <Button Grid.Column="2" Content="Рассчитать" Click="Calculate"/>
                    <Button Grid.Column="4" Content="Рассчитать с контурами и 3D" Click="CalculateGraphics" Style="{StaticResource PrimaryButton}"/>
                    <Button Grid.Column="6" Content="Закрыть" Click="CloseWindow" IsCancel="True"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>