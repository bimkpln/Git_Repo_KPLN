<Window x:Class="KPLN_Tools.Forms.ExpitVolume"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KPLN. Получение объема котлована"
        Width="700"
        Height="540"
        ResizeMode="NoResize"
        SizeToContent="Manual"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Header="1. Исходное топотело" Margin="0,0,0,10">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Height="30" Content="Выбрать топотело" Click="PickToposolid_Click"/>
                <TextBlock x:Name="ToposolidText" Grid.Column="1" Margin="12,0,0,0"
                           VerticalAlignment="Center" Text="Не выбрано" TextTrimming="CharacterEllipsis"/>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="1" Header="2. Модель котлована" Margin="0,0,0,10">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Row="0" Grid.Column="0" Height="30" Content="Выбрать элементы" Click="PickCutters_Click"/>
                <TextBlock x:Name="CuttersText" Grid.Row="0" Grid.Column="1" Margin="12,0,0,0"
                           VerticalAlignment="Center" Text="Не выбрано" TextTrimming="CharacterEllipsis"/>
                <ListBox x:Name="CuttersList"
                         Grid.Row="1"
                         Grid.ColumnSpan="2"
                         Height="82"
                         Margin="0,8,0,0"
                         Visibility="Collapsed"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="Результат" Margin="0,0,0,14">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="430"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Объём исходного топотела:"/>
                <TextBlock x:Name="OriginalVolumeText" Grid.Row="0" Grid.Column="1"
                           FontWeight="Bold" Foreground="#0078D4" Text="—"/>
                <TextBlock Grid.Row="1" Margin="0,7,0,0" Text="Объём модели котлована:"/>
                <TextBlock x:Name="CutVolumeText" Grid.Row="1" Grid.Column="1" Margin="0,7,0,0"
                           FontWeight="Bold" Foreground="#0078D4" Text="—"/>
                <TextBlock Grid.Row="2" Margin="0,7,0,0" Text="Объём выемки:"/>
                <TextBlock x:Name="ExcavationVolumeText" Grid.Row="2" Grid.Column="1"
                           Margin="0,7,0,0" FontWeight="Bold" Foreground="#0078D4" Text="—"/>
                <TextBlock x:Name="StatusText" Grid.Row="3" Grid.ColumnSpan="2"
                           Margin="0,12,0,0" TextWrapping="Wrap" Foreground="DarkSlateGray"/>
            </Grid>
        </GroupBox>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="125" Height="32" Margin="0,0,8,0" Content="Рассчитать" Click="Calculate_Click"/>
            <Button x:Name="WriteButton" Width="125" Height="32" Margin="0,0,8,0"
                    Content="Записать" IsEnabled="False" Click="Write_Click"/>
            <Button Width="90" Height="32" Content="Закрыть" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>