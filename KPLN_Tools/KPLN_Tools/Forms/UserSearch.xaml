<Window x:Class="KPLN_Tools.Forms.UserSearch"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:KPLN_Tools.Forms"
        Title="KPLN: Поиск пользователя" Width="540" Height="500"
        MinWidth="460" MinHeight="350" Background="#2B2F38"
        FontFamily="Consolas, Segoe UI" WindowStyle="ToolWindow"
        WindowStartupLocation="CenterScreen" Loaded="OnLoaded">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/KPLN_Library_Forms;component/UI/LibStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <local:EmptyStringToDashConverter x:Key="EmptyStringToDashConverter" />
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <Style x:Key="UserText" TargetType="TextBlock" BasedOn="{StaticResource KPLN_TextBlock}">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="MaxWidth" Value="Infinity" />
            </Style>
            <Style x:Key="UserLabel" TargetType="TextBlock" BasedOn="{StaticResource UserText}">
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Style="{StaticResource KPLN_CardBorder}">
            <StackPanel>
                <TextBlock Text="Имя Revit-пользователя:" Style="{StaticResource KPLN_TextBlock}" HorizontalAlignment="Left" MaxWidth="Infinity" />
                <TextBox x:Name="UserInput" Style="{StaticResource KPLN_TextBox}"
                         TextWrapping="NoWrap" TextChanged="UserInput_TextChanged" />
                <CheckBox x:Name="IncludeFired" Content="Включать уволенных сотрудников"
                          IsChecked="False" Style="{StaticResource KPLN_CheckBox}"
                          Checked="IncludeFired_Changed" Unchecked="IncludeFired_Changed" />
                <StackPanel x:Name="SelectionPanel" Visibility="Collapsed">
                    <CheckBox x:Name="OnlySelection" Content="Только пользователи выбранного элемента"
                              Style="{StaticResource KPLN_CheckBox}"
                              Checked="IncludeFired_Changed" Unchecked="IncludeFired_Changed" />
                    <TextBlock x:Name="SelectionInfo" Style="{StaticResource UserText}" />
                </StackPanel>
            </StackPanel>
        </Border>
        <ListBox x:Name="Users" Grid.Row="1" Margin="4" Background="#333840"
                 Foreground="#EDEDED" BorderThickness="0"
                 ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                 MouseLeftButtonUp="Users_MouseLeftButtonUp"
                 ToolTip="Нажми ЛКМ, чтобы открыть карточку пользователя в Bitrix24">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="6" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Row" Padding="{TemplateBinding Padding}"
                                        Background="Transparent" BorderBrush="#515863" BorderThickness="0,0,0,1">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Row" Property="Background" Value="#414957" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Row" Property="Background" Value="#31547B" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
<ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="145"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="2" Grid.RowSpan="3" Width="205" Margin="12,0,0,0"
                                            Visibility="{Binding ShowRoles, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Связь с элементом" Style="{StaticResource UserLabel}" Foreground="#8DBBFF" />
                                    <TextBlock Text="{Binding Roles}" Style="{StaticResource UserText}" />
                                </StackPanel>
                                

                                <TextBlock 
                                    Grid.Row="0" 
                                    Grid.Column="0" 
                                    Text="Учетка Windows:" 
                                    Style="{StaticResource UserLabel}" 
                                    HorizontalAlignment="Left" 
                                    Margin="0,5,5,5"/>

                                <TextBlock 
                                    Grid.Row="0" 
                                    Grid.Column="1" 
                                    Text="{Binding Path=DBSystemName, Converter={StaticResource EmptyStringToDashConverter}}" 
                                    Style="{StaticResource UserText}" 
                                    HorizontalAlignment="Left" 
                                    Margin="0,5,5,5"/>

                                <TextBlock 
                                    Grid.Row="1" 
                                    Grid.Column="0" 
                                    Text="ФИО, отдел: " 
                                    Style="{StaticResource UserLabel}" 
                                    HorizontalAlignment="Left" 
                                    Margin="0,5,5,5"/>

                                <TextBlock 
                                    Grid.Row="1" 
                                    Grid.Column="1" 
                                    Text="{Binding Path=UserDataView, Converter={StaticResource EmptyStringToDashConverter}}" 
                                    Style="{StaticResource UserText}" 
                                    HorizontalAlignment="Left" 
                                    Margin="0,5,5,5"/>

                                <TextBlock 
                                    Grid.Row="2" 
                                    Grid.Column="0" 
                                    Text="Учетка Revit:" 
                                    Style="{StaticResource UserLabel}" 
                                    HorizontalAlignment="Left" 
                                    Margin="0,5,5,5"/>

                                <TextBlock 
                                    Grid.Row="2" 
                                    Grid.Column="1"
                                    Text="{Binding Path=DBRevitUserName, Converter={StaticResource EmptyStringToDashConverter}}" 
                                    Style="{StaticResource UserText}" 
                                    HorizontalAlignment="Left" 
                                    Margin="0,5,5,5"/>

                                
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="SearchStatus" Grid.Row="2" Style="{StaticResource UserText}" />
    </Grid>
</Window>
