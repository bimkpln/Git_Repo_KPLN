<Window x:Class="KPLN_Tools.Forms.VentilationSettingsConfiguratorMain"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KPLN. Конфигуратор вент. установок"
        Width="1400" Height="800" SizeToContent="Manual"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F3F5F7" FontFamily="Segoe UI" FontSize="13"
        Closing="Window_Closing" Closed="Window_Closed">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="#CBD2DA"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CompactListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="94"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="Конфигуратор вент. установок" FontSize="23" FontWeight="SemiBold" Foreground="#182C40"/>
            <TextBlock Text="Настройки вентиляционной установки" Margin="0,7,0,0" Foreground="#586777"/>
        </StackPanel>
        <Grid x:Name="EditorPanel" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Background="White" BorderBrush="#DBE1E7" BorderThickness="1" CornerRadius="6" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Список проектов" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <!-- Выделяется запись базы, соответствующая активной модели Revit. -->
                    <ListBox x:Name="ProjectsListBox" Grid.Row="1" BorderThickness="0"
                             FontSize="12" ItemContainerStyle="{StaticResource CompactListItemStyle}"
                             SelectionChanged="ProjectsListBox_SelectionChanged"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}" ToolTip="{Binding Description}"
                                           TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
            <Border Grid.Column="2" Background="White" BorderBrush="#DBE1E7" BorderThickness="1"
                    CornerRadius="6" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Типы семейства" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <!-- Пока пусто. После привязки папки здесь будут все типы найденного RFA. -->
                    <ListBox x:Name="FamilyTypesListBox" Grid.Row="1" BorderThickness="0" FontSize="12"
                             ItemContainerStyle="{StaticResource CompactListItemStyle}"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" ToolTip="{Binding}" TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
            <Grid Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Background="White" BorderBrush="#DBE1E7" BorderThickness="1" CornerRadius="6" Padding="18">
                    <StackPanel>
                        <TextBlock Text="Проект" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8"/>
                        <TextBlock x:Name="ProjectNameTextBlock" Text="Неизвестно" Margin="0,0,0,10"
                                   Foreground="#30475E" TextTrimming="CharacterEllipsis"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Путь" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBox x:Name="ProjectPathTextBox" Grid.Column="1"
                                     Text="Нет открытого файла" IsReadOnly="True" IsTabStop="False"
                                     Background="#F8FAFC" Foreground="#788492"/>
                        </Grid>
                        <TextBlock Text="Имя нового типа" FontWeight="SemiBold" Margin="0,16,0,8"/>
                        <TextBox x:Name="TypeNameTextBox" ToolTip="Например: П1 — приточная установка"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="2" Background="White" BorderBrush="#DBE1E7" BorderThickness="1" CornerRadius="6" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Настройки установки" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,12"/>
                        <!-- Список намеренно пуст. Поля и правила заполнения добавятся следующим этапом. -->
                        <ListBox x:Name="SettingsListBox" Grid.Row="1" BorderBrush="#E3E8EE"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
        <Border Grid.Row="2" Background="#E8EDF3" CornerRadius="5" Padding="12" Margin="0,14,0,14">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="StatusTextBlock" Text="Введите имя типа и выберите действие."
                           Foreground="#30475E" TextWrapping="Wrap"/>
            </ScrollViewer>
        </Border>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="CloseButton" Content="Закрыть" Click="Close_Click"/>
            <Button x:Name="OpenButton" Grid.Column="2" Content="Открыть в Revit" Click="OpenInRevit_Click" Margin="0,0,10,0"/>
            <Button x:Name="AddButton" Grid.Column="3" Content="Добавить в проект" Click="AddToProject_Click"
                    Background="#244F78" Foreground="White" BorderBrush="#244F78"/>
        </Grid>
    </Grid>
</Window>
