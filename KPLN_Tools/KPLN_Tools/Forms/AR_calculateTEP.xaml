<Window x:Class="KPLN_Tools.Forms.AR_calculateTEP"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KPLN. Расчёт ТЭП" Height="790" Width="1180"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
            <Setter Property="Padding" Value="12,2"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="4,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="4,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="4,4"/>
        </Style>
    </Window.Resources>
    <DockPanel Margin="12">
        <Border DockPanel.Dock="Top" Background="#243447" Padding="14" CornerRadius="4" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Расчёт технико-экономических показателей" Foreground="White" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="Активная модель, Revit-связи, проверяемая детализация и журнал проблем" Foreground="#DCE6F1" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>
        <Grid x:Name="Footer" DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="LastResultButton" Content="Последний расчёт" Click="LastResultButton_Click"/>
                <Button x:Name="ImportButton" Content="Импорт настроек" Click="ImportButton_Click"/>
                <Button x:Name="ExportSettingsButton" Content="Экспорт настроек" Click="ExportSettingsButton_Click"/>
                <Button x:Name="ClearButton" Content="Очистить данные ТЭП" Click="ClearButton_Click"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="ExportCsvButton" Content="Экспорт CSV" Visibility="Collapsed" Click="ExportCsvButton_Click"/>
                <Button x:Name="ExportXlsxButton" Content="Экспорт XLSX" Visibility="Collapsed" Click="ExportXlsxButton_Click"/>
                <Button x:Name="CloseButton" Content="Закрыть" IsCancel="True" Click="CloseButton_Click"/>
                <Button x:Name="CalculateButton" Content="Рассчитать" IsDefault="True" Background="#2D78B7" Foreground="White" Click="CalculateButton_Click"/>
            </StackPanel>
        </Grid>
        <TabControl x:Name="MainTabs">
            <TabItem Header="1. Показатели" x:Name="IndicatorsTab">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <CheckBox x:Name="AllIndicatorsCheckBox" Content="Рассчитать все показатели" IsChecked="True" FontWeight="SemiBold" Checked="AllIndicatorsCheckBox_Changed" Unchecked="AllIndicatorsCheckBox_Changed"/>
                        <TextBlock Text="Выключите флажок, чтобы выбрать отдельные показатели" Foreground="#666" VerticalAlignment="Center" Margin="20,0,0,0"/>
                    </StackPanel>
                    <DataGrid x:Name="IndicatorsGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Считать" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="75"/>
                            <DataGridTextColumn Header="№" Binding="{Binding Number}" Width="55" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Показатель" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Ед." Binding="{Binding Unit}" Width="70" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="2. Методика">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <GroupBox Header="Методика суммарной поэтажной площади">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="NewMethodRadio" Content="Новая методика" IsChecked="True" Margin="4" Checked="MethodRadio_Checked"/>
                                <RadioButton x:Name="OldMethodRadio" Content="Старая методика" Margin="24,4,4,4" Checked="MethodRadio_Checked"/>
                                <TextBlock Text="Версия правил:" VerticalAlignment="Center" Margin="35,0,0,0"/>
                                <TextBox x:Name="RulesVersionTextBox" Width="80" Height="24" Margin="8,0,0,0" Padding="3" Text="1.0"/>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Формулы выбранной методики">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <Button DockPanel.Dock="Right" Content="Вернуть формулы по умолчанию" MinWidth="205" Click="ResetFormulaRulesButton_Click"/>
                                    <TextBlock TextWrapping="Wrap" Foreground="#555" VerticalAlignment="Center" Text="Формулы старой и новой методик хранятся раздельно. Поддерживаются числа, скобки и операции +, -, *, /. Ошибка в одной формуле не прерывает остальные показатели."/>
                                </DockPanel>
                                <DataGrid x:Name="FormulaRulesGrid" Height="235" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="№" Binding="{Binding Number}" Width="55" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Показатель" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Формула" Binding="{Binding Expression, UpdateSourceTrigger=PropertyChanged}" Width="300"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Expander Header="Доступные переменные формул" Margin="0,6,0,0">
                                    <TextBlock Margin="8" TextWrapping="Wrap" Foreground="#555" Text="A_ALL — общая учитываемая площадь; A_RES_BUILDING / A_NONRES_BUILDING — площади жилых / нежилых зданий; A_RES_IN_RES_BUILDING / A_NONRES_IN_RES_BUILDING — жилая / нежилая часть жилых зданий; A_ABOVE / A_BELOW — наземная / подземная площадь; A_ABOVE_RES_BUILDING / A_ABOVE_NONRES_BUILDING — наземные площади по типу здания; A_NNP_BUILTIN / A_NNP_STANDALONE — ННП; A_PUBLIC / A_PUBLIC_CALC — общественная / расчётная общественная площадь; A_APT_COEF / A_APT_HEATED — площади квартир; FOOTPRINT — площадь застройки; V_ALL / V_ABOVE / V_BELOW — объёмы; COUNT_APT / COUNT_PARKING — количества; FLOORS_ABOVE / FLOORS_ALL — этажи."/>
                                </Expander>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Тип объекта">
                            <ComboBox x:Name="BuildingTypeCombo" SelectedIndex="0" Height="24">
                                <ComboBoxItem Content="Жилое здание до 75 м" Tag="Residential"/>
                                <ComboBoxItem Content="Общественное здание до 50 м" Tag="Public"/>
                                <ComboBoxItem Content="Высотное здание / комплекс" Tag="HighRise"/>
                                <ComboBoxItem Content="Определять по параметрам помещений" Tag="ByParameters"/>
                            </ComboBox>
                        </GroupBox>
                        <GroupBox Header="Основа расчёта площадей">
                            <StackPanel>
                                <ComboBox x:Name="AreaBasisCombo" SelectedIndex="0" Height="24">
                                    <ComboBoxItem Content="Помещения (Rooms)" Tag="Rooms"/>
                                    <ComboBoxItem Content="Зоны (Areas)" Tag="Areas"/>
                                </ComboBox>
                                <TextBlock TextWrapping="Wrap" Foreground="#666" Margin="4,4,4,0" Text="Площадь застройки и строительный объём автоматически оцениваются по доступной геометрии. Неоднозначный результат помечается как требующий проверки."/>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Отметки и этажи">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="250"/>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Отметка 0.000, м:" VerticalAlignment="Center"/>
                                <TextBox x:Name="ZeroElevationTextBox" Grid.Column="1" Text="0" Height="24" Padding="3"/>
                                <TextBlock Grid.Row="1" Text="Планировочная отметка земли, м:" VerticalAlignment="Center"/>
                                <TextBox x:Name="GroundElevationTextBox" Grid.Row="1" Grid.Column="1" Text="0" Height="24" Padding="3"/>
                                <TextBlock Grid.Row="2" Text="Ключевые слова исключаемых уровней:" VerticalAlignment="Center"/>
                                <TextBox x:Name="ExcludedLevelsTextBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="чердак,техподполье,подполье,кровля" Height="24" Padding="3"/>
                            </Grid>
                        </GroupBox>
                        <GroupBox Header="Группировка и границы по корпусам">
                            <StackPanel>
                                <ComboBox x:Name="GroupingCombo" SelectedIndex="0" Height="24">
                                    <ComboBoxItem Content="По Revit-связям" Tag="Link"/>
                                    <ComboBoxItem Content="По параметру корпуса" Tag="Parameter"/>
                                    <ComboBoxItem Content="По рабочему набору" Tag="Workset"/>
                                </ComboBox>
                                <TextBlock Text="Рассчитывать только корпуса (через запятую; пусто - все):" Margin="4,6,4,0"/>
                                <TextBox x:Name="SelectedBuildingsTextBox" Height="24" Padding="3"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="3. Источники">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="SourcesGrid" AutoGenerateColumns="False" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Включить" Binding="{Binding IsIncluded, UpdateSourceTrigger=PropertyChanged}" Width="75"/>
                            <DataGridTextColumn Header="Источник" Binding="{Binding Name}" IsReadOnly="True" Width="*"/>
                            <DataGridTextColumn Header="Тип" Binding="{Binding Kind}" IsReadOnly="True" Width="120"/>
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" IsReadOnly="True" Width="180"/>
                            <DataGridCheckBoxColumn Header="Только графика" Binding="{Binding GraphicsOnly, UpdateSourceTrigger=PropertyChanged}" Width="115"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="1" Margin="0,8,0,0" Foreground="#666" Text="Выгруженные и недоступные связи попадут в журнал предупреждений и не остановят расчёт."/>
                </Grid>
            </TabItem>
            <TabItem Header="4. Параметры и классификация">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <GroupBox Header="Имена параметров" Margin="0,0,6,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="230"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Корпус" VerticalAlignment="Center"/>
                                <TextBox x:Name="BuildingParamTextBox" Grid.Column="1" Text="Корпус" Padding="3"/>
                                <TextBlock Grid.Row="1" Text="Тип здания" VerticalAlignment="Center"/>
                                <TextBox x:Name="BuildingTypeParamTextBox" Grid.Row="1" Grid.Column="1" Text="Тип здания" Padding="3"/>
                                <TextBlock Grid.Row="2" Text="Функциональное назначение" VerticalAlignment="Center"/>
                                <TextBox x:Name="FunctionParamTextBox" Grid.Row="2" Grid.Column="1" Text="Назначение" Padding="3"/>
                                <TextBlock Grid.Row="3" Text="ID / номер квартиры" VerticalAlignment="Center"/>
                                <TextBox x:Name="ApartmentParamTextBox" Grid.Row="3" Grid.Column="1" Text="Номер квартиры" Padding="3"/>
                                <TextBlock Grid.Row="4" Text="Признак летнего помещения" VerticalAlignment="Center"/>
                                <TextBox x:Name="SummerParamTextBox" Grid.Row="4" Grid.Column="1" Text="Летнее помещение" Padding="3"/>
                                <TextBlock Grid.Row="5" Text="Коэффициент летнего помещения" VerticalAlignment="Center"/>
                                <TextBox x:Name="SummerCoefParamTextBox" Grid.Row="5" Grid.Column="1" Text="Коэффициент" Padding="3"/>
                                <TextBlock Grid.Row="6" Text="Признак машино-места" VerticalAlignment="Center"/>
                                <TextBox x:Name="ParkingParamTextBox" Grid.Row="6" Grid.Column="1" Text="Машино-место" Padding="3"/>
                                <TextBlock Grid.Row="7" Text="Встроенно-пристроенная ННП" VerticalAlignment="Center"/>
                                <TextBox x:Name="BuiltInParamTextBox" Grid.Row="7" Grid.Column="1" Text="Встроенно-пристроенное" Padding="3"/>
                                <TextBlock Grid.Row="8" Text="Отдельно стоящий объект" VerticalAlignment="Center"/>
                                <TextBox x:Name="StandaloneParamTextBox" Grid.Row="8" Grid.Column="1" Text="Отдельно стоящий" Padding="3"/>
                                <TextBlock Grid.Row="9" Text="Включение в ТЭП" VerticalAlignment="Center"/>
                                <TextBox x:Name="IncludeParamTextBox" Grid.Row="9" Grid.Column="1" Text="Включить в ТЭП" Padding="3"/>
                            </Grid>
                        </GroupBox>
                        <GroupBox Grid.Column="1" Header="Словари (значения через запятую)" Margin="6,0,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Жилые" VerticalAlignment="Center"/>
                                <TextBox x:Name="ResidentialWordsTextBox" Grid.Column="1" Text="жил,квартир" Padding="3"/>
                                <TextBlock Grid.Row="1" Text="Общественные" VerticalAlignment="Center"/>
                                <TextBox x:Name="PublicWordsTextBox" Grid.Row="1" Grid.Column="1" Text="обществен,офис,торгов,детск,школ,медицин" Padding="3"/>
                                <TextBlock Grid.Row="2" Text="Технические" VerticalAlignment="Center"/>
                                <TextBox x:Name="TechnicalWordsTextBox" Grid.Row="2" Grid.Column="1" Text="техническ,венткамера,щитовая,итп,насосная" Padding="3"/>
                                <TextBlock Grid.Row="3" Text="Летние помещения" VerticalAlignment="Center"/>
                                <TextBox x:Name="SummerWordsTextBox" Grid.Row="3" Grid.Column="1" Text="балкон,лоджия,терраса,веранда" Padding="3"/>
                                <TextBlock Grid.Row="4" Text="Исключать из расчётной площади" VerticalAlignment="Center"/>
                                <TextBox x:Name="ExcludedPublicWordsTextBox" Grid.Row="4" Grid.Column="1" Text="коридор,тамбур,переход,лестнич,шахт,пандус,инженер" Padding="3"/>
                                <TextBlock Grid.Row="5" Text="Подземные" VerticalAlignment="Center"/>
                                <TextBox x:Name="UndergroundWordsTextBox" Grid.Row="5" Grid.Column="1" Text="подзем,подвал,цоколь,паркинг" Padding="3"/>
                                <TextBlock Grid.Row="6" Text="Значения «нет/исключить»" VerticalAlignment="Center"/>
                                <TextBox x:Name="FalseWordsTextBox" Grid.Row="6" Grid.Column="1" Text="нет,false,0,исключить,не учитывать" Padding="3"/>
                            </Grid>
                        </GroupBox>
                    </Grid>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="5. Вывод">
                <StackPanel Margin="10">
                    <GroupBox Header="Результаты">
                        <StackPanel>
                            <CheckBox x:Name="ShowResultsCheckBox" Content="Показать результат в окне" IsChecked="True"/>
                            <CheckBox x:Name="CreateScheduleCheckBox" Content="Создать/обновить спецификацию Revit"/>
                            <CheckBox x:Name="ExportCsvCheckBox" Content="Экспортировать CSV"/>
                            <CheckBox x:Name="ExportXlsxCheckBox" Content="Экспортировать XLSX"/>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="Проверочная графика">
                        <StackPanel>
                            <CheckBox x:Name="CreateViewsCheckBox" Content="Создать/обновить проверочные виды"/>
                            <CheckBox x:Name="Create3DCheckBox" Content="Создать/обновить 3D-вид проверки"/>
                            <CheckBox x:Name="UpdateGraphicsCheckBox" Content="Обновлять ранее созданные данные" IsChecked="True"/>
                            <TextBlock Text="Префикс создаваемых объектов:" Margin="4,8,4,2"/>
                            <TextBox x:Name="PrefixTextBox" Width="240" HorizontalAlignment="Left" Text="ТЭП_" Padding="3"/>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="Точность и журнал">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Знаков после запятой:" VerticalAlignment="Center"/>
                                <ComboBox x:Name="RoundingCombo" Width="80" SelectedIndex="2" Margin="10,0,0,0">
                                    <ComboBoxItem Content="0"/>
                                    <ComboBoxItem Content="1"/>
                                    <ComboBoxItem Content="2"/>
                                    <ComboBoxItem Content="3"/>
                                </ComboBox>
                                <CheckBox x:Name="DetailedWarningsCheckBox" Content="Подробные предупреждения" IsChecked="True" Margin="30,4,4,4"/>
                            </StackPanel>
                            <TextBlock Text="Ручные итоговые корректировки (строка: номер показателя = новое значение | причина):" Margin="4,8,4,0"/>
                            <TextBox x:Name="ManualCorrectionsTextBox" Height="70" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="3"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </TabItem>
            <TabItem Header="Результаты" x:Name="ResultsTab" Visibility="Collapsed">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Border Background="#EAF3E5" Padding="10" Margin="0,0,0,8">
                        <TextBlock x:Name="ResultStatusText" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </Border>
                    <DataGrid x:Name="ResultsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="№" Binding="{Binding Number}" Width="45"/>
                            <DataGridTextColumn Header="Показатель" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Значение" Binding="{Binding DisplayValue}" Width="100"/>
                            <DataGridTextColumn Header="Ед." Binding="{Binding Unit}" Width="60"/>
                            <DataGridTextColumn Header="Корпус" Binding="{Binding Building}" Width="120"/>
                            <DataGridTextColumn Header="Источник" Binding="{Binding Source}" Width="170"/>
                            <DataGridTextColumn Header="Методика" Binding="{Binding Method}" Width="120"/>
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="130"/>
                            <DataGridTextColumn Header="Комментарий" Binding="{Binding Comment}" Width="220"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Детализация" x:Name="DetailsTab" Visibility="Collapsed">
                <DataGrid x:Name="DetailsGrid" Margin="8" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False" MouseDoubleClick="DetailsGrid_MouseDoubleClick"/>
            </TabItem>
            <TabItem Header="Предупреждения" x:Name="WarningsTab" Visibility="Collapsed">
                <DataGrid x:Name="WarningsGrid" Margin="8" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False" MouseDoubleClick="WarningsGrid_MouseDoubleClick"/>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>