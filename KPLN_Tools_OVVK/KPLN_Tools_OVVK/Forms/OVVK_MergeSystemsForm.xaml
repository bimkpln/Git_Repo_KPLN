<Window x:Class="KPLN_Tools_OVVK.Forms.OVVK_MergeSystemsForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:local="clr-namespace:KPLN_Tools_OVVK.Forms"
        mc:Ignorable="d" 
        MinWidth="560" MaxWidth="1250"
        MinHeight="150"
        MaxHeight="750"
        SizeToContent="WidthAndHeight"
        ResizeMode="CanMinimize"
        SizeChanged="Window_SizeChanged"
        Topmost="True"
        Title="KPLN: ОВВК — Объединить системы"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/KPLN_Library_Forms;component/UI/LibStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="MainButtons" TargetType="{x:Type Button}" BasedOn="{StaticResource BTN}">
                <Setter Property="Height" Value="30"/>
                <Setter Property="Width" Value="250"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Margin" Value="5,5,5,5"/>
            </Style>
            <Style x:Key="ItemButtons" TargetType="{x:Type Button}" BasedOn="{StaticResource BTN}">
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="VerticalAlignment" Value="Stretch"/>
                <Setter Property="Margin" Value="5,5,5,5"/>
            </Style>
            <Style x:Key="MainTBlock" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource TXT}">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Margin" Value="5"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="TBlock" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource TXT}">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Margin" Value="5"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
            </Style>
            <Style x:Key="TBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource TXB}">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Margin" Value="5,0,5,0"/>
                <Setter Property="Padding" Value="5"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="TextAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
            </Style>
            <Style x:Key="CBox" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource CBX}">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Margin" Value="5"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <StackPanel x:Name="ModelConfigPicker" Visibility="Collapsed" Margin="10,5" HorizontalAlignment="Center">
                <TextBlock Text="Для этой модели настройки не сохранены. Можно загрузить группы другой модели:"
                           TextWrapping="Wrap" MaxWidth="500" Margin="5"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <ComboBox x:Name="SavedModelNames" Width="340" DisplayMemberPath="ModelName" Margin="5"
                              ToolTip="Выбери модель, настройки которой нужно загрузить"/>
                    <Button Content="Загрузить" Click="LoadModelConfig_Click" Margin="5" Padding="10,3"/>
                </StackPanel>
            </StackPanel>
            <DockPanel
                LastChildFill="False"
                HorizontalAlignment="Center">
                <Button
                    Click="AddNewGroup_Click"
                    Content="Добавить группу"
                    Style="{StaticResource MainButtons}"/>
                <Button
                    Click="Run_Click"
                    Content="Выполнить"
                    Style="{StaticResource MainButtons}"/>
            </DockPanel>

            <GridSplitter 
                Height="3"
                HorizontalAlignment="Stretch"/>
        </StackPanel>
        
        <ScrollViewer 
            Grid.Row="1"
            HorizontalScrollBarVisibility="Auto"
            HorizontalContentAlignment="Center"
            VerticalScrollBarVisibility="Auto">
            <ItemsControl 
                x:Name="SysIControll" HorizontalAlignment="Center" Margin="8,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel LastChildFill="True" Margin="0,2" HorizontalAlignment="Center">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                <Button Content="+" Width="26" Height="26" Margin="2,5" Click="AddSystem_Click"
                                        IsEnabled="{Binding CanAddSystem}" ToolTip="{Binding AddSystemToolTip}" ToolTipService.ShowOnDisabled="True"/>
                                <Button Content="✖" Foreground="Red" Width="26" Height="26" Margin="2,5"
                                        Click="Del_Click" ToolTip="Удалить группу"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Systems}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="+" VerticalAlignment="Center" Margin="3,0">
                                                <TextBlock.Style><Style TargetType="TextBlock">
                                                    <Style.Triggers><DataTrigger Binding="{Binding IsFirst}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger></Style.Triggers>
                                                </Style></TextBlock.Style>
                                            </TextBlock>
                                            <ComboBox Width="180" ItemsSource="{Binding SystemParameters}"
                                                      SelectedValue="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                      Style="{StaticResource CBox}"
                                                      ToolTip="При выборе первой системы вторая подбирается автоматически. Любую систему можно изменить вручную."/>
                                            <Button Content="−" Width="20" Height="20" Margin="0,5,2,5" Click="RemoveSystem_Click"
                                                    ToolTip="Убрать эту систему из группы">
                                                <Button.Style><Style TargetType="Button">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers><DataTrigger Binding="{Binding CanRemove}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger></Style.Triggers>
                                                </Style></Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <DockPanel Grid.Row="2" LastChildFill="False" HorizontalAlignment="Center" Margin="0,6,0,0">
            <Button Click="SaveConfig_Click" Content="Сохранить"
                    ToolTip="Сохранить общие группы объединения для проекта и выбранного параметра"
                    Style="{StaticResource MainButtons}"/>
            <Button Click="Clear_Click" Content="Очистить"
                    ToolTip="Удалить все группы из окна. Значения элементов Revit не изменяются."
                    Style="{StaticResource MainButtons}"/>
        </DockPanel>
        <TextBlock Grid.Row="3" x:Name="ConfigStatus" Style="{StaticResource TBlock}" Foreground="#2B2F38" MaxWidth="500"/>
    </Grid>
</Window>
