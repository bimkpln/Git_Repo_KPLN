<Window x:Class="KPLN_Tools_OVVK.Forms.OVVK_SystemManagerForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KPLN: ОВВК — Менеджер систем"
        Width="850" Height="700" MinWidth="680" MinHeight="440"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Consolas, 'Segoe UI', monospace"
        Background="#2B2F38"
        WindowStartupLocation="CenterOwner">
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseWindowCmd}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
    </Window.InputBindings>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/KPLN_Library_Forms;component/UI/LibStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="ManagerText" TargetType="TextBlock" BasedOn="{StaticResource KPLN_TextBlock}">
                <Setter Property="MaxWidth" Value="Infinity"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Margin" Value="0"/>
            </Style>
            <Style x:Key="ManagerAction" TargetType="Button" BasedOn="{StaticResource KPLN_Button}">
                <Setter Property="MinHeight" Value="42"/>
                <Setter Property="Margin" Value="0,0,0,10"/>
                <Setter Property="Padding" Value="10,8"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource KPLN_CardBorder}" Margin="0,0,0,12" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding CurrentOVVK_SystemManagerM.DocumentTitle}"
                           Style="{StaticResource ManagerText}" FontWeight="Bold" Margin="0,0,0,10"/>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Группировать по:" Style="{StaticResource ManagerText}" Margin="0,0,12,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding CurrentOVVK_SystemManagerM.ParameterDisplayName}"
                               ToolTip="{Binding CurrentOVVK_SystemManagerM.ParameterName}"
                               Style="{StaticResource ManagerText}" FontWeight="Bold" Margin="0,0,10,0"/>
                    <Button Grid.Column="2" Content="Выбрать…" Command="{Binding SelectParameterCmd}"
                            IsEnabled="{Binding CurrentOVVK_SystemManagerM.CanSelectParameter}"
                            ToolTip="Выбрать общий текстовый параметр элементов ОВВК"
                            Style="{StaticResource KPLN_ElementPickButton}" MinHeight="34" Padding="12,5"/>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="210"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource KPLN_CardBorder}" Margin="0" Padding="12">
                <Grid DataContext="{Binding CurrentOVVK_SystemManagerM}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Системы по выбранному параметру" Style="{StaticResource ManagerText}" FontWeight="Bold"/>
                        <TextBlock Text="Ctrl / Shift — выбрать несколько строк. 3D-виды создаются только для выбранных систем; замечания пропускаются."
                                   TextWrapping="Wrap" Foreground="#AEB8C8" Margin="0,6,0,0"/>
                        <TextBlock Text="{Binding SelectionSummary}" Foreground="#AEB8C8" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ListBox Grid.Row="1" x:Name="SystemsList" SelectionChanged="SystemsList_SelectionChanged"
                             SelectionMode="Extended" IsEnabled="{Binding CanRefresh}"
                             Background="Transparent" Foreground="#EDEDED" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="4,6"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" FontSize="14">
                                    <TextBlock.ToolTip>
                                        <TextBlock Text="{Binding Description}" MaxWidth="420" TextWrapping="Wrap"/>
                                    </TextBlock.ToolTip>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                                    <Setter Property="Foreground" Value="#FFB454"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                                    <Setter Property="Foreground" Value="#FF7777"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="Действия" Style="{StaticResource ManagerText}" FontWeight="Bold" Margin="0,0,0,12"/>
                    <Button Content="{Binding CurrentOVVK_SystemManagerM.SelectSystemButtonText}" Command="{Binding SelectSystemCmd}"
                            IsEnabled="{Binding CurrentOVVK_SystemManagerM.CanSelectSystem}"
                            ToolTip="Выделить элементы всех выбранных строк: систем, ошибок и предупреждений">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ManagerAction}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentOVVK_SystemManagerM.HasSelectedWarnings}" Value="True">
                                        <Setter Property="Background" Value="#FFB454"/>
                                        <Setter Property="Foreground" Value="#2B2F38"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentOVVK_SystemManagerM.HasSelectedErrors}" Value="True">
                                        <Setter Property="Background" Value="#C94850"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Обновить список" Command="{Binding RefreshSystemsCmd}"
                            IsEnabled="{Binding CurrentOVVK_SystemManagerM.CanRefresh}" Style="{StaticResource ManagerAction}"/>
                    <Button Content="Обновить имя системы" Command="{Binding RefreshSystemNamesCmd}"
                            IsEnabled="{Binding CurrentOVVK_SystemManagerM.CanRefresh}"
                            ToolTip="Сопоставить сокращения с именами типов систем и обновить системы труб и воздуховодов во всей модели"
                            Style="{StaticResource ManagerAction}"/>
                    <Button Content="Заполнить параметр" Command="{Binding FillSystemNameCmd}"
                            IsEnabled="{Binding CurrentOVVK_SystemManagerM.CanFillSystemName}"
                            Style="{StaticResource ManagerAction}">
                        <Button.ToolTip>
                            <TextBlock MaxWidth="310" TextWrapping="Wrap"
                                       Text="Записать имена типов систем в параметр из строки «Группировать по» на текущем виде или во всей модели. Применяются категории и исключения менеджера. Вложенные семейства получают значение родителя. Существующие значения будут обновлены."/>
                        </Button.ToolTip>
                    </Button>
                    <Button Content="Объединить системы" Command="{Binding MergeSystemsCmd}"
                            IsEnabled="{Binding CurrentOVVK_SystemManagerM.CanMergeSystems}"
                            ToolTip="Объединить значения выбранного параметра. Нужны минимум две системы и параметр экземпляра у всех элементов."
                            Style="{StaticResource ManagerAction}"/>
                    <Button Content="{Binding CurrentOVVK_SystemManagerM.CreateViewsButtonText}" Command="{Binding CreateViewsCmd}"
                            IsEnabled="{Binding CurrentOVVK_SystemManagerM.CanCreateViews}" Style="{StaticResource ManagerAction}">
                        <Button.ToolTip>
                            <TextBlock MaxWidth="310" TextWrapping="Wrap"
                                       Text="Создать схемы только для выбранных обычных строк систем. Выбранные ошибки и предупреждения пропускаются и не блокируют остальные системы. Основа — открытый 3D-вид; в его шаблоне управление фильтрами должно быть отключено."/>
                        </Button.ToolTip>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="2" Margin="0,12,0,0" DataContext="{Binding CurrentOVVK_SystemManagerM}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="{Binding TypeParameterWarning}" Foreground="#FFB454" TextWrapping="Wrap" Margin="0,0,0,8">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource ManagerText}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasTypeParameters}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Grid.Row="1" Text="{Binding UserHelp}" Style="{StaticResource ManagerText}" Foreground="#FF7777" Margin="0,0,0,8"/>
            <TextBlock Grid.Row="2" Text="{Binding UserMainStatus}" Style="{StaticResource ManagerText}" Foreground="#AEB8C8"/>
        </Grid>
    </Grid>
</Window>
