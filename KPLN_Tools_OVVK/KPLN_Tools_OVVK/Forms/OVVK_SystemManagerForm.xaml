<Window x:Class="KPLN_Tools_OVVK.Forms.OVVK_SystemManagerForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KPLN: ОВВК — Менеджер систем"
        Width="850" Height="600" MinWidth="680" MinHeight="440"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Consolas, 'Segoe UI', monospace"
        Background="#2B2F38"
        WindowStartupLocation="CenterOwner">
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseWindowCmd}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
    </Window.InputBindings>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/KPLN_Library_Forms;component/UI/LibStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="ManagerText" TargetType="TextBlock" BasedOn="{StaticResource KPLN_TextBlock}">
                <Setter Property="MaxWidth" Value="Infinity"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Margin" Value="0"/>
            </Style>
            <Style x:Key="ManagerAction" TargetType="Button" BasedOn="{StaticResource KPLN_Button}">
                <Setter Property="MinHeight" Value="42"/>
                <Setter Property="Margin" Value="0,0,0,10"/>
                <Setter Property="Padding" Value="10,8"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource KPLN_CardBorder}" Margin="0,0,0,12" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding CurrentOVVK_SystemManagerM.DocumentTitle}"
                           Style="{StaticResource ManagerText}" FontWeight="Bold" Margin="0,0,0,10"/>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Группировать по:" Style="{StaticResource ManagerText}" Margin="0,0,12,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding CurrentOVVK_SystemManagerM.ParameterDisplayName}"
                               ToolTip="{Binding CurrentOVVK_SystemManagerM.ParameterName}"
                               Style="{StaticResource ManagerText}" FontWeight="Bold" Margin="0,0,10,0"/>
                    <Button Grid.Column="2" Content="Выбрать…" Command="{Binding SelectParameterCmd}"
                            IsEnabled="{Binding CurrentOVVK_SystemManagerM.CanSelectParameter}"
                            ToolTip="Выбрать общий текстовый параметр элементов ОВВК"
                            Style="{StaticResource KPLN_ElementPickButton}" MinHeight="34" Padding="12,5"/>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="210"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource KPLN_CardBorder}" Margin="0" Padding="12">
                <Grid DataContext="{Binding CurrentOVVK_SystemManagerM}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Системы по выбранному параметру" Style="{StaticResource ManagerText}"
                               FontWeight="Bold" Margin="0,0,0,12"/>
                    <ListBox Grid.Row="1" ItemsSource="{Binding SystemSumParameters}"
                             Background="Transparent" Foreground="#EDEDED" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="4,6"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="14"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Действия" Style="{StaticResource ManagerText}" FontWeight="Bold" Margin="0,0,0,12"/>
                <Button Content="Обновить список" Command="{Binding RefreshSystemsCmd}"
                        IsEnabled="{Binding CurrentOVVK_SystemManagerM.CanRefresh}" Style="{StaticResource ManagerAction}"/>
                <Button Content="Объединить системы" Command="{Binding MergeSystemsCmd}"
                        IsEnabled="{Binding CurrentOVVK_SystemManagerM.CanMergeSystems}"
                        ToolTip="Объединить значения выбранного параметра. Нужны минимум две системы."
                        Style="{StaticResource ManagerAction}"/>
                <Button Content="Создать 3D-виды" Command="{Binding CreateViewsCmd}"
                        IsEnabled="{Binding CurrentOVVK_SystemManagerM.CanCreateViews}" Style="{StaticResource ManagerAction}">
                    <Button.ToolTip>
                        <TextBlock MaxWidth="310" TextWrapping="Wrap"
                                   Text="Создаёт аксонометрические схемы на основе открытого 3D-вида. В шаблоне вида управление фильтрами должно быть отключено."/>
                    </Button.ToolTip>
                </Button>
                <Button Content="Выделить ошибки" Command="{Binding SelectWarningsCmd}"
                        IsEnabled="{Binding CurrentOVVK_SystemManagerM.CanSelectWarnings}"
                        ToolTip="Выделить элементы с пустым, отсутствующим или неподходящим параметром системы"
                        Style="{StaticResource ManagerAction}" Background="#804044"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="0,12,0,0" DataContext="{Binding CurrentOVVK_SystemManagerM}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="{Binding UserHelp}" Style="{StaticResource ManagerText}" Foreground="#FF7777" Margin="0,0,0,8"/>
            <TextBlock Grid.Row="1" Text="{Binding UserMainStatus}" Style="{StaticResource ManagerText}" Foreground="#AEB8C8"/>
        </Grid>
    </Grid>
</Window>
