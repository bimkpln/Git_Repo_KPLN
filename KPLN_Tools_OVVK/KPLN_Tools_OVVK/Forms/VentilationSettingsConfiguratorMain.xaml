<Window x:Class="KPLN_Tools_OVVK.Forms.VentilationSettingsConfiguratorMain"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KPLN. Конфигуратор вент. установок"
        Width="1400" Height="950" SizeToContent="Manual"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F3F5F7" FontFamily="Segoe UI" FontSize="13"
        Closing="Window_Closing" Closed="Window_Closed">
    <Window.Resources>
        <DataTemplate x:Key="SectionTypeTemplate">
            <StackPanel>
                <TextBlock Text="{Binding TypeName}" FontSize="13" FontWeight="SemiBold" Foreground="#20334A" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding FamilyName}" FontSize="11" Foreground="#69788B" TextWrapping="Wrap" Margin="0,3,0,0"/>
            </StackPanel>
        </DataTemplate>
        <Style x:Key="TypeChoiceItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#F0F5FC"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#E6F0FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CleanComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CDD6E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource TypeChoiceItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="FieldBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"/>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" CornerRadius="6">
                                            <Path Data="M 0 0 L 4 4 L 8 0" Stroke="#718197" StrokeThickness="1.5"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,0"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False" Margin="11,6,34,6" VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                            <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Background="White" BorderBrush="#CDD6E1" BorderThickness="1" CornerRadius="6" Padding="4" Margin="0,4,0,0"
                                        Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="#8FA7C5"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="#3479C5"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="#3479C5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="SectionSelectButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="3"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SectionButtonBorder" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" CornerRadius="4" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="SectionButtonBorder" Property="BorderBrush" Value="#3479C5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#53657A"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="IconBackground" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="IconBackground" Property="Background" Value="#E8EDF3"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="IconBackground" Property="Background" Value="#E8EDF3"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="IconBackground" Property="Background" Value="#D9E1EB"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.25"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="#CBD2DA"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="DimensionTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="MinHeight" Value="34"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsReadOnly}" Value="True">
                    <Setter Property="Background" Value="#EDF1F5"/>
                    <Setter Property="Foreground" Value="#53657A"/>
                    <Setter Property="IsTabStop" Value="False"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsValid}" Value="False">
                    <Setter Property="BorderBrush" Value="Firebrick"/>
                    <Setter Property="Foreground" Value="Firebrick"/>
                    <Setter Property="Background" Value="#FFF3F3"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CreateTypeButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#286AA6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="5"
                                BorderBrush="#1D5282" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#347DBD"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#112F4D"/>
                                <Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#1D5282"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CompactListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="28"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Конфигуратор вент. установок" FontSize="23" FontWeight="SemiBold" Foreground="#182C40"/>
                <TextBlock x:Name="ProjectHeaderTextBlock" Text="Неизвестно"
                           Margin="0,7,0,0" Foreground="#586777" TextWrapping="Wrap"
                           MaxHeight="52" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock Text="Имя типа" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBox x:Name="TypeNameTextBox" TextChanged="TypeName_TextChanged" IsEnabled="False"/>
            </StackPanel>
        </Grid>
        <Grid x:Name="EditorPanel" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Background="White" BorderBrush="#DBE1E7" BorderThickness="1" CornerRadius="6" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Типы семейства" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <Button x:Name="CreateTypeButton" Content="＋  Создать тип" Click="CreateType_Click"
                                AutomationProperties.Name="Создать тип" Style="{StaticResource CreateTypeButtonStyle}"/>
                    </StackPanel>
                    <ListBox x:Name="FamilyTypesListBox" Grid.Row="1" BorderThickness="0" FontSize="12"
                             SelectionChanged="FamilyTypesListBox_SelectionChanged"
                             ItemContainerStyle="{StaticResource CompactListItemStyle}"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="24"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding DisplayName}" ToolTip="{Binding DisplayName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCreate}" Value="True">
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                        <Setter Property="Foreground" Value="#244F78"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Button Grid.Column="1" Width="20" Height="20" Click="DeleteType_Click" ToolTip="Удалить тип">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCreate}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <Path Data="M 1 1 L 9 9 M 9 1 L 1 9" Stroke="#C33F45" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="10" Height="10"/>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
            <Grid Grid.Column="2">
                <TextBlock x:Name="NoTypeTextBlock" Text="Выберите «Создать тип», чтобы настроить новую установку или выберите уже имеющийся тип."
                           Foreground="#586777" FontSize="16" TextWrapping="Wrap"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"/>
                <TabControl x:Name="ConfigurationTabs" Visibility="Collapsed" Background="White" BorderBrush="#DBE1E7">
                    <TabItem Header="Инфо" Padding="16,8">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="InfoPanel" Margin="16" MaxWidth="740" HorizontalAlignment="Left" MinWidth="480">
                                <TextBlock Text="Имя системы" Foreground="#586777" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding SystemName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16"/>
                                <TextBlock Text="Завод-изготовитель" Foreground="#586777" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding Manufacturer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16"/>
                                <TextBlock Text="Марка" Foreground="#586777" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding Mark, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16"/>
                                <TextBlock Text="Единица измерения" Foreground="#586777" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding Unit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16"/>
                                <TextBlock Text="Наименование" Foreground="#586777" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16"/>
                                <TextBlock Text="Код изделия" Foreground="#586777" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding ProductCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16"/>
                                <TextBlock Text="Масса" Foreground="#586777" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding MassText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Установка" Padding="16,8">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="16">
                                <Grid Margin="0,0,0,12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="600"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                        <TextBlock Text="Всего блоков" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <ComboBox x:Name="SectionCountComboBox" Width="76" Style="{StaticResource CleanComboBoxStyle}"
                                              SelectionChanged="SectionCount_SelectionChanged"/>
                                        <CheckBox x:Name="AddValveCheckBox" Content="Добавить клапан" Margin="22,0,0,0" VerticalAlignment="Center"
                                              Checked="AddValve_CheckedChanged" Unchecked="AddValve_CheckedChanged"/>
                                    </StackPanel>
                                    <ContentControl x:Name="InstallationWidthEditor" Grid.Column="1" HorizontalContentAlignment="Stretch"/>
                                    <ContentControl x:Name="AdditionalInstallationEditor" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,14,0,0" HorizontalContentAlignment="Stretch"/>
                                </Grid>
                                <TextBlock x:Name="CompositionSummaryTextBlock" Text="Состав установки" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <UniformGrid x:Name="SectionBlocksPanel" Rows="1" Columns="12"/>
                                <Border Background="#F5F8FB" BorderBrush="#DBE1E7" BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,12,0,0">
                                    <StackPanel x:Name="SelectedSectionPanel"/>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
        <Border Grid.Row="2" Background="#E8EDF3" CornerRadius="5" Padding="12,10" Margin="0,12,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusTextBlock" Grid.Column="1" Text="Выберите «Создать тип», чтобы начать."
                           Foreground="#30475E" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <Button x:Name="ErrorDetailsButton" Content="Подробности" Click="ErrorDetails_Click"
                        Visibility="Collapsed" MinHeight="28" Padding="10,4" Margin="0,0,12,0"/>
            </Grid>
        </Border>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="CloseButton" Content="Закрыть" Click="Close_Click"/>
            <Button x:Name="SaveButton" Grid.Column="2" Content="Сохранить" Click="Save_Click" Margin="0,0,10,0"/>
            <Button x:Name="OpenButton" Grid.Column="3" Content="Открыть в Revit" Click="OpenInRevit_Click" Margin="0,0,10,0"/>
            <Button x:Name="AddButton" Grid.Column="4" Content="Добавить в проект" Click="AddToProject_Click"
                    Background="#244F78" Foreground="White" BorderBrush="#244F78"/>
        </Grid>
    </Grid>
</Window>