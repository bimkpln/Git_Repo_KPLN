<Window x:Class="KPLN_OpeningHoleManager.Forms.OpeningHistoryFilterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KPLN: Фильтры отверстий" Width="480" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" WindowStyle="ToolWindow"
        Background="#2B2F38" FontFamily="Segoe UI">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/KPLN_Library_Forms;component/UI/LibStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="TextBlock" BasedOn="{StaticResource KPLN_TextBlock}">
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="FontSize" Value="14"/>
            </Style>
            <Style TargetType="ComboBox" BasedOn="{StaticResource KPLN_ComboBox}">
                <Style.Resources>
                    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="Black"/></Style>
                </Style.Resources>
                <Setter Property="Foreground" Value="Black"/>
                <Setter Property="MinHeight" Value="34"/>
                <Setter Property="Margin" Value="0,6,0,18"/>
            </Style>
            <Style TargetType="Button" BasedOn="{StaticResource KPLN_Button}">
                <Setter Property="Padding" Value="12,7"/>
                <Setter Property="Margin" Value="4,0"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <StackPanel Margin="20">
        <TextBlock Text="Фильтры списка отверстий" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,18"/>
        <TextBlock Text="Уровень"/>
        <ComboBox ItemsSource="{Binding Levels}" DisplayMemberPath="Name" SelectedValuePath="Id"
                  SelectedValue="{Binding LevelId, Mode=TwoWay}" IsEditable="False"/>
        <TextBlock Text="Статус отверстия"/>
        <ComboBox ItemsSource="{Binding StatusOptions}" DisplayMemberPath="Name" SelectedValuePath="Value"
                  SelectedValue="{Binding Status, Mode=TwoWay}" IsEditable="False"/>
        <CheckBox Style="{StaticResource KPLN_CheckBox}" Content="Только на активном виде"
                  IsChecked="{Binding OnlyActiveView, Mode=TwoWay}" Foreground="#EDEDED" Margin="0,0,0,10"/>
        <TextBlock Text="Фильтры применяются вместе с текстовым поиском. При переключении вида список обновляется автоматически."
                   FontSize="12" Foreground="#BBC3D1" Margin="0,0,0,20"/>
        <DockPanel LastChildFill="False">
            <Button Content="Сбросить" Click="Reset_Click" DockPanel.Dock="Left"/>
            <Button Content="Применить" Click="Apply_Click" IsDefault="True" DockPanel.Dock="Right"/>
            <Button Content="Отмена" IsCancel="True" DockPanel.Dock="Right"/>
        </DockPanel>
    </StackPanel>
</Window>
