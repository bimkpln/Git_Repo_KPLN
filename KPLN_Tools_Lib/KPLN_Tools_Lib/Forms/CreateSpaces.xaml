<Window x:Class="KPLN_Tools_Lib.Forms.CreateSpaces"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KPLN: Создать пространства" Width="700" Height="575"
        MinWidth="540" MinHeight="455" WindowStartupLocation="CenterOwner"
        Background="#2B2F38" Foreground="#EDEDED" FontFamily="Segoe UI">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/KPLN_Library_Forms;component/UI/LibStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseWindowCmd}" />
    </Window.InputBindings>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Style="{StaticResource KPLN_TextBlock}" MaxWidth="10000" FontSize="16" FontWeight="SemiBold"
                   Text="Выберите связи, из которых брать помещения" Margin="0,0,0,12" />
        <DockPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Style="{StaticResource KPLN_TextBlock}" Text="Стадия пространств:" VerticalAlignment="Center" Margin="0,0,10,0" />
            <ComboBox Style="{StaticResource KPLN_ComboBox}" ItemsSource="{Binding CurrentCreateSpacesM.Phases}" DisplayMemberPath="Name"
                      SelectedItem="{Binding CurrentCreateSpacesM.SelectedPhase}" />
        </DockPanel>
        <Border Grid.Row="2" Style="{StaticResource KPLN_CardBorder}" Padding="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding CurrentCreateSpacesM.Links}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Style="{StaticResource KPLN_CheckBox}" Margin="0,5"
                                      IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}">
                                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
        <StackPanel Grid.Row="3">
            <Border Background="#173D50" BorderBrush="#64C8F0" BorderThickness="1" CornerRadius="4"
                    Padding="9,7" Margin="0,12,0,0">
                <TextBlock Foreground="#DDF5FF" FontSize="12" TextWrapping="Wrap"
                           Text="В списке только загруженные связи. Если нужной связи нет — загрузите её в Revit и откройте эту команду заново." />
            </Border>
        <TextBlock Style="{StaticResource KPLN_TextBlock}" MaxWidth="10000" FontSize="13" TextWrapping="Wrap" Margin="0,12"
                   Text="Уровни сопоставляются по отметкам с учётом положения связи (допуск 1 мм). Существующие пространства пропускаются. Для границ пространств включите у архитектурной связи параметр «Граница помещений»." />
        </StackPanel>
        <DockPanel Grid.Row="4" LastChildFill="False">
            <Button DockPanel.Dock="Left" Style="{StaticResource KPLN_Button}" Content="Выбрать все" Command="{Binding SelectAllCmd}" Margin="0,0,8,0" />
            <Button DockPanel.Dock="Left" Style="{StaticResource KPLN_Button}" Content="Снять выбор" Command="{Binding SelectNoneCmd}" />
            <Button DockPanel.Dock="Right" Style="{StaticResource KPLN_RunButton}" Content="Создать" Command="{Binding RunCmd}" IsDefault="True" Margin="8,0,0,0" />
            <Button DockPanel.Dock="Right" Style="{StaticResource KPLN_Button}" Content="Отмена" Command="{Binding CloseWindowCmd}" />
        </DockPanel>
    </Grid>
</Window>
