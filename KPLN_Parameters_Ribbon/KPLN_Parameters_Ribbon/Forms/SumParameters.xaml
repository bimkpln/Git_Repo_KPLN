<Window x:Class="KPLN_Parameters_Ribbon.Forms.SumParameters"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="KPLN: Сумма параметров"
        WindowStartupLocation="CenterOwner"
        Width="800"
        Height="420"
        MinWidth="800"
        MinHeight="260"
        FontFamily="Consolas, 'Segoe UI', monospace"
        Background="#2B2F38">

    <Window.InputBindings>
        <KeyBinding
            Key="Escape"
            Command="{Binding CloseWindowCmd}"
            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />
    </Window.InputBindings>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Style="{StaticResource RCTG}"
            DataContext="{Binding CurrentSumParametersM}">
            <StackPanel Orientation="Vertical">

                <Button
                    x:Name="BtnUpdate"
                    Width="80"
                    Height="28"
                    Style="{StaticResource BTN}"
                    HorizontalAlignment="Left"
                    Content="Получить"
                    Command="{Binding DataContext.UpdateSumResultsCmd, RelativeSource={RelativeSource AncestorType=Window}}" />

                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Style="{StaticResource TXT}"
                        FontSize="12"
                        Text="Поиск:" />

                    <TextBox
                        Width="250"
                        Height="28"
                        Style="{StaticResource TXB}"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Style="{StaticResource TXT}"
                        FontSize="12"
                        Text="Округлять результат до" />

                    <Border
                        Height="28"
                        Margin="0,2,6,2"
                        BorderBrush="#515761"
                        BorderThickness="1"
                        CornerRadius="3"
                        Background="#252A32">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Width="28"
                                Style="{StaticResource TXT}"
                                Margin="0"
                                FontSize="12"
                                TextAlignment="Center"
                                Text="{Binding RoundDigits}" />
                            <Button
                                Width="24"
                                Height="24"
                                Padding="0"
                                Margin="0"
                                BorderThickness="0"
                                Background="Transparent"
                                Foreground="#EDEDED"
                                Content="+"
                                Command="{Binding DataContext.IncreaseRoundDigitsCmd, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <Button
                                Width="24"
                                Height="24"
                                Padding="0"
                                Margin="0"
                                BorderThickness="0"
                                Background="Transparent"
                                Foreground="#EDEDED"
                                Content="-"
                                Command="{Binding DataContext.DecreaseRoundDigitsCmd, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </StackPanel>
                    </Border>

                    <TextBlock
                        Style="{StaticResource TXT}"
                        FontSize="12"
                        Text="знаков." />

                    <TextBlock
                        Style="{StaticResource TXT}"
                        FontSize="12"
                        Text="Коэффициент запаса, % :" />

                    <TextBox
                        Width="80"
                        Height="28"
                        Style="{StaticResource TXB}"
                        Text="{Binding CoefficientText, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

            </StackPanel>
        </Border>

        <DataGrid
            Grid.Row="1"
            Margin="4"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            CanUserResizeRows="False"
            IsReadOnly="True"
            HeadersVisibility="Column"
            GridLinesVisibility="All"
            HorizontalGridLinesBrush="#D4D4D4"
            VerticalGridLinesBrush="#D4D4D4"
            RowBackground="White"
            AlternatingRowBackground="#FAFAFA"
            BorderBrush="#BDBDBD"
            BorderThickness="1"
            ItemsSource="{Binding CurrentSumParametersM.FilteredSumResults}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Имя параметра" Binding="{Binding ParameterName}" Width="*" />
                <DataGridTextColumn Header="Значение" Binding="{Binding ValueText}" Width="125" />
                <DataGridTextColumn Header="Ед.изм." Binding="{Binding UnitName}" Width="70" />
                <DataGridTextColumn Header="Σ с коэфф." Binding="{Binding ValueWithCoefficientText}" Width="135" />
                <DataGridTextColumn Header="Σ без коэфф." Binding="{Binding ValueWithoutCoefficientText}" Width="135" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
